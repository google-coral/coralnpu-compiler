+// Peels single-use, same-region util.optimization_barrier wrappers above |use|
+// to return the underlying root OpOperand, or nullptr if |use| crosses a
+// region, repeats a barrier operand, or passes through a multi-use barrier or
+// arith.select merge that cannot guarantee exclusive ownership.
+static OpOperand *unwrapExclusivePassthroughUse(OpOperand &use) {
+  OpOperand *cur = &use;
+  while (auto res = dyn_cast<OpResult>(cur->get())) {
+    Operation *op = res.getOwner();
+    if (isa<IREE::Util::OptimizationBarrierOp>(op)) {
+      Value src = op->getOperand(res.getResultNumber());
+      if (!cur->get().hasOneUse() ||
+          op->getParentRegion() != cur->getOwner()->getParentRegion() ||
+          llvm::count(op->getOperands(), src) > 1) {
+        return nullptr;
       }
+      cur = &op->getOpOperand(res.getResultNumber());
+      continue;
+    }
+    if (isa<mlir::arith::SelectOp>(op)) {
+      return nullptr;
     }
+    break;
   }
-  return true;
+  return cur;
 }
 
