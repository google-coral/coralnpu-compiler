-    return true;
+          // If the op reports explicit access ranges, check for writes on this
+          // resource. No write -> let Explorer follow tied results in case a
+          // downstream op mutates them.
+          if (auto accessOp =
+                  dyn_cast<IREE::Stream::AsyncAccessOpInterface>(owner)) {
+            SmallVector<AsyncAccessRange> ranges;
+            accessOp.getAsyncAccessRanges(ranges);
+            bool hasWrite =
