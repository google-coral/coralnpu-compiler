-      continue;
+//  - Conservative fallback: unknown tied ops, indirect global stores, or
+//    incomplete traversals are assumed to mutate.
+// Keep passthrough handling in sync with walkTransitiveUsesThroughPassthroughs
+// in ElideAsyncCopies.cpp.
+static bool hasMutatingTiedUses(Value root, Explorer &explorer) {
+  SmallVector<Value> worklist = {root};
+  SmallPtrSet<Value, 8> visited = {root};
+  auto enqueue = [&](Value v) {
+    if (visited.insert(v).second) {
+      worklist.push_back(v);
     }
-    Operation *owner = use.getOwner();
+  };
+  while (!worklist.empty()) {
+    Value value = worklist.pop_back_val();
+    bool hasMutation = false;
+    TraversalResult traversalResult =
+        explorer.walkTransitiveUses(value, [&](OpOperand &use) -> WalkResult {
+          Operation *owner = use.getOwner();
+          unsigned operandIdx = use.getOperandNumber();
+          if (isa<IREE::Util::OptimizationBarrierOp>(owner)) {
+            enqueue(owner->getResult(operandIdx));
+            return WalkResult::advance();
+          }
+          if (auto selectOp = dyn_cast<mlir::arith::SelectOp>(owner)) {
+            enqueue(selectOp.getResult());
+            return WalkResult::advance();
+          }
+          if (isa<IREE::Util::GlobalStoreIndirectOpInterface>(owner)) {
+            hasMutation = true;
+            return WalkResult::interrupt();
+          }
 
-    // Ops that tie resources purely for scheduling/synchronization.
-    if (owner->hasTrait<OpTrait::IREE::Stream::TiedResourcePassthrough>()) {
-      continue;
-    }
+          auto tiedOp = dyn_cast<IREE::Util::TiedOpInterface>(owner);
+          if (!tiedOp || !tiedOp.isOperandTied(operandIdx)) {
+            return WalkResult::advance();
+          }
 
-    // Streamable metadata ops pass resources through unchanged.
-    if (auto streamableOp =
-            dyn_cast<IREE::Stream::StreamableOpInterface>(owner)) {
-      if (streamableOp.isMetadata()) {
-        continue;
-      }
-    }
+          // Ops that tie resources purely for scheduling/synchronization.
+          if (owner->hasTrait<
+                  OpTrait::IREE::Stream::TiedResourcePassthrough>()) {
+            return WalkResult::advance();
+          }
 
-    // If the op reports explicit access ranges, check for writes on this
-    // resource. No write → not a mutation.
-    if (auto accessOp = dyn_cast<IREE::Stream::AsyncAccessOpInterface>(owner)) {
-      SmallVector<AsyncAccessRange> ranges;
-      accessOp.getAsyncAccessRanges(ranges);
-      bool hasWrite = llvm::any_of(ranges, [&](const AsyncAccessRange &range) {
-        return range.resource == use.get() && !range.isReadOnly();
-      });
-      if (hasWrite) {
-        return true;
-      }
-      continue;
-    }
+          // Streamable metadata ops pass resources through unchanged.
+          if (auto streamableOp =
+                  dyn_cast<IREE::Stream::StreamableOpInterface>(owner)) {
+            if (streamableOp.isMetadata()) {
