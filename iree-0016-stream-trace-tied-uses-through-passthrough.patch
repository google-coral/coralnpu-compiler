+
+// Walks transitive uses of |root|, stepping through value passthroughs
+// (util.optimization_barrier and arith.select) that Explorer does not follow.
+// Keep passthrough handling in sync with hasMutatingTiedUses in
+// ResourceUsage.cpp.
+static TraversalResult walkTransitiveUsesThroughPassthroughs(
+    Value root, Explorer &explorer,
+    llvm::function_ref<WalkResult(OpOperand &)> fn) {
+  SmallVector<Value> worklist = {root};
+  SmallPtrSet<Value, 8> visited = {root};
+  auto enqueue = [&](Value v) {
+    if (visited.insert(v).second) {
+      worklist.push_back(v);
+    }
+  };
 
-    Operation *userPos = projectToRegion(user, valueRegion);
-    if (!userPos) {
+  auto traversalResult = TraversalResult::COMPLETE;
+  while (!worklist.empty()) {
+    Value cur = worklist.pop_back_val();
+    bool interrupted = false;
+    traversalResult |=
+        explorer.walkTransitiveUses(cur, [&](OpOperand &operand) -> WalkResult {
+          Operation *owner = operand.getOwner();
+          if (isa<IREE::Util::OptimizationBarrierOp>(owner)) {
+            enqueue(owner->getResult(operand.getOperandNumber()));
+            return WalkResult::advance();
+          }
+          if (auto selectOp = dyn_cast<mlir::arith::SelectOp>(owner)) {
+            enqueue(selectOp.getResult());
+            return WalkResult::advance();
+          }
+          if (isa<IREE::Util::GlobalStoreIndirectOpInterface>(owner)) {
+            traversalResult |= TraversalResult::INCOMPLETE;
+            interrupted = true;
+            return WalkResult::interrupt();
+          }
+          WalkResult result = fn(operand);
+          if (result.wasInterrupted()) {
+            interrupted = true;
+          }
+          return result;
+        });
+    if (interrupted) {
+      break;
+    }
+  }
+  return traversalResult;
+}
+
+// Collects the underlying non-passthrough values feeding |value| through
+// util.optimization_barrier and arith.select ops.
+static void collectPassthroughSources(Value value,
+                                      SmallVectorImpl<Value> &sources) {
+  SmallVector<Value, 4> worklist = {value};
+  SmallPtrSet<Value, 4> visited = {value};
+  auto enqueue = [&](Value v) {
+    if (visited.insert(v).second) {
+      worklist.push_back(v);
+    }
+  };
+  while (!worklist.empty()) {
+    Value cur = worklist.pop_back_val();
+    auto res = dyn_cast<OpResult>(cur);
+    if (!res) {
+      sources.push_back(cur);
       continue;
     }
+    Operation *op = res.getOwner();
+    if (isa<IREE::Util::OptimizationBarrierOp>(op)) {
+      enqueue(op->getOperand(res.getResultNumber()));
+      continue;
+    }
+    if (auto selectOp = dyn_cast<mlir::arith::SelectOp>(op)) {
+      enqueue(selectOp.getTrueValue());
+      enqueue(selectOp.getFalseValue());
+      continue;
+    }
+    sources.push_back(cur);
+  }
+}
 
