From 35c4bdd70aa06118e77aceecb8074a7228ba0b89 Mon Sep 17 00:00:00 2001
From: Eryk Szpotanski <eszpotanski@antmicro.com>
Date: Mon, 6 Jul 2026 19:18:44 +0200
Subject: [PATCH 1/2] [IR] use signed 16-bit ints and add support for bit width
 of index

Signed-off-by: Eryk Szpotanski <eszpotanski@antmicro.com>
---
 mlir/lib/IR/Builders.cpp | 3 ++-
 mlir/lib/IR/Types.cpp    | 6 +++++-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/mlir/lib/IR/Builders.cpp b/mlir/lib/IR/Builders.cpp
index cf64954751d5..a08101b20e12 100644
--- a/mlir/lib/IR/Builders.cpp
+++ b/mlir/lib/IR/Builders.cpp
@@ -219,7 +219,8 @@ IntegerAttr Builder::getUI32IntegerAttr(uint32_t value) {
 }
 
 IntegerAttr Builder::getI16IntegerAttr(int16_t value) {
-  return IntegerAttr::get(getIntegerType(16), APInt(16, value));
+  return IntegerAttr::get(getIntegerType(16),
+                          APInt(16, value, /*isSigned=*/true));
 }
 
 IntegerAttr Builder::getI8IntegerAttr(int8_t value) {
diff --git a/mlir/lib/IR/Types.cpp b/mlir/lib/IR/Types.cpp
index ec10a5ce9e2e..263aac1e5a7e 100644
--- a/mlir/lib/IR/Types.cpp
+++ b/mlir/lib/IR/Types.cpp
@@ -8,6 +8,7 @@
 
 #include "mlir/IR/BuiltinTypes.h"
 #include "mlir/IR/Dialect.h"
+#include "llvm/Support/Casting.h"
 
 using namespace mlir;
 using namespace mlir::detail;
@@ -122,7 +123,10 @@ bool Type::isIntOrFloat() const {
 bool Type::isIntOrIndexOrFloat() const { return isIntOrFloat() || isIndex(); }
 
 unsigned Type::getIntOrFloatBitWidth() const {
-  assert(isIntOrFloat() && "only integers and floats have a bitwidth");
+  assert(isIntOrIndexOrFloat() &&
+         "only integers, indexes and floats have a bitwidth");
+  if (isIndex())
+    return llvm::dyn_cast<IndexType>(*this).kInternalStorageBitWidth;
   if (auto intType = llvm::dyn_cast<IntegerType>(*this))
     return intType.getWidth();
   return llvm::cast<FloatType>(*this).getWidth();
-- 
