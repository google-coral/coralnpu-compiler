From 9ffeaacfce535be2d77a905db598bf537196b896 Mon Sep 17 00:00:00 2001
From: Eryk Szpotanski <eszpotanski@antmicro.com>
Date: Mon, 6 Jul 2026 19:18:44 +0200
Subject: [PATCH 1/3] use signed 16-bit ints

Signed-off-by: Eryk Szpotanski <eszpotanski@antmicro.com>
---
 mlir/lib/IR/Builders.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/mlir/lib/IR/Builders.cpp b/mlir/lib/IR/Builders.cpp
index cf64954751d5..a08101b20e12 100644
--- a/mlir/lib/IR/Builders.cpp
+++ b/mlir/lib/IR/Builders.cpp
@@ -219,7 +219,8 @@ IntegerAttr Builder::getUI32IntegerAttr(uint32_t value) {
 }
 
 IntegerAttr Builder::getI16IntegerAttr(int16_t value) {
-  return IntegerAttr::get(getIntegerType(16), APInt(16, value));
+  return IntegerAttr::get(getIntegerType(16),
+                          APInt(16, value, /*isSigned=*/true));
 }
 
 IntegerAttr Builder::getI8IntegerAttr(int8_t value) {
