From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shaked Flur <sflur@google.com>
Date: Tue, 10 Nov 2026 00:00:00 +0100
Subject: [PATCH] Decode the scalar operand of vfmerge.vf as a floating-point register

`vfmerge_vf` (`vfmerge.vfm` in the RISC-V Vector specification, OPFVF encoding)
merges elements from vector register `vs2` and scalar floating-point register
`f[rs1]` under mask `v0`. Previously, `coralnpu_m3.isa` declared the second
source operand as vector register `vs1` instead of floating-point register
`frs1`, causing the simulator to read `v[rs1]` as a vector operand instead of
broadcasting scalar `f[rs1]`.
---
diff --git a/sim/coralnpu_m3.isa b/sim/coralnpu_m3.isa
--- a/sim/coralnpu_m3.isa
+++ b/sim/coralnpu_m3.isa
@@ -97,8 +97,8 @@ slot riscv_zve32f {
     vfmv_vf{: frs1, vmask : vd},
       disasm: "vfmv.vf", "%vd, %frs1, %vmask",
       semfunc: "&::mpact::sim::riscv::Vfmvvf";
-    vfmerge_vf{: vs2, vs1, vmask : vd},
-      disasm: "vfmerge.vf", "%vd, %vs2, %vs1, %vmask",
+    vfmerge_vf{: vs2, frs1, vmask : vd},
+      disasm: "vfmerge.vf", "%vd, %vs2, %frs1, %vmask",
       semfunc: "&::mpact::sim::riscv::Vfmerge";
     vmfeq_vv{: vs2, vs1, vmask : vd},
       disasm: "vmfeq.vv", "%vd, %vs2, %vs1, %vmask",
