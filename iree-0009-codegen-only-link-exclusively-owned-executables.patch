From c622358faf5737be0659de8e19e9ca1c2280d230 Mon Sep 17 00:00:00 2001
From: Lun Dong <lundong@google.com>
Date: Fri, 4 Sep 2026 17:36:56 -0700
Subject: [PATCH] [Codegen] only link exclusively owned executables

---
 compiler/src/iree/compiler/Codegen/Utils/LinkingUtils.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/compiler/src/iree/compiler/Codegen/Utils/LinkingUtils.cpp b/compiler/src/iree/compiler/Codegen/Utils/LinkingUtils.cpp
index f7563963b..a6a83c557 100644
--- a/compiler/src/iree/compiler/Codegen/Utils/LinkingUtils.cpp
+++ b/compiler/src/iree/compiler/Codegen/Utils/LinkingUtils.cpp
@@ -33,8 +33,10 @@ gatherExecutablesForTarget(mlir::ModuleOp moduleOp, StringRef targetName,
                            bool lazy) {
   SmallVector<IREE::HAL::ExecutableOp> result;
   for (auto executableOp : moduleOp.getOps<IREE::HAL::ExecutableOp>()) {
+    // Only gather executables owned exclusively by this backend; partially
+    // linking one desyncs hal.executable.lookup from its export ordinals.
     if (executableOp.getLazy() == lazy &&
-        llvm::any_of(executableOp.getOps<IREE::HAL::ExecutableVariantOp>(),
+        llvm::all_of(executableOp.getOps<IREE::HAL::ExecutableVariantOp>(),
                      [&](IREE::HAL::ExecutableVariantOp variantOp) {
                        return variantOp.getTarget().getBackend().getValue() ==
                               targetName;
-- 
