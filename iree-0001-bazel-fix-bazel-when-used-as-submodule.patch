From c2305bf73a03a0c18424cd012fe4e72a693bf8f4 Mon Sep 17 00:00:00 2001
From: Shaked Flur <sflur@google.com>
Date: Wed, 25 Feb 2026 16:26:55 +0100
Subject: [PATCH] [Bazel] fix bazel when used as submodule

---
 build_tools/bazel/extensions.bzl             | 26 +++++++++++---------
 build_tools/bazel/iree_bitcode_library.bzl   | 10 +++-----
 build_tools/bazel/iree_flatcc.bzl            | 10 ++++++--
 build_tools/bazel/renamed_link.bzl           |  9 ++++++-
 compiler/src/iree/compiler/API/BUILD.bazel   | 13 +++++++++-
 runtime/src/BUILD.bazel                      |  5 ++++
 runtime/src/iree/vm/bytecode/isa/BUILD.bazel |  8 +++---
 7 files changed, 56 insertions(+), 25 deletions(-)

diff --git a/build_tools/bazel/extensions.bzl b/build_tools/bazel/extensions.bzl
index e8c274edb..06e33403e 100644
--- a/build_tools/bazel/extensions.bzl
+++ b/build_tools/bazel/extensions.bzl
@@ -20,23 +20,27 @@ def _iree_extension_impl(module_ctx):
     iree_is_root = any([m.is_root and m.name == "iree_core" for m in module_ctx.modules])
 
     # Create MLIR-adjacent source repositories only when IREE is the root
-    # module. Downstream consumers can provide their own LLVM, StableHLO, and
-    # torch-mlir repositories when IREE is part of a larger project.
+    # module. Downstream consumers can provide their own LLVM repository when
+    # IREE is part of a larger project.
     if iree_is_root:
         new_local_repository(
             name = "llvm-raw",
             build_file_content = "# empty",
             path = iree_root + "/third_party/llvm-project",
         )
-        local_repository(
-            name = "stablehlo",
-            path = iree_root + "/third_party/stablehlo",
-        )
-        new_local_repository(
-            name = "torch-mlir-raw",
-            build_file_content = "# empty - BUILD files overlaid by torch_mlir_configure",
-            path = iree_root + "/third_party/torch-mlir",
-        )
+
+    # StableHLO
+    local_repository(
+        name = "stablehlo",
+        path = iree_root + "/third_party/stablehlo",
+    )
+
+    # Torch-MLIR
+    new_local_repository(
+        name = "torch-mlir-raw",
+        build_file_content = "# empty - BUILD files overlaid by torch_mlir_configure",
+        path = iree_root + "/third_party/torch-mlir",
+    )
 
     # Googletest
     local_repository(
diff --git a/build_tools/bazel/iree_bitcode_library.bzl b/build_tools/bazel/iree_bitcode_library.bzl
index dd9a41d0e..01bc5df0c 100644
--- a/build_tools/bazel/iree_bitcode_library.bzl
+++ b/build_tools/bazel/iree_bitcode_library.bzl
@@ -67,7 +67,7 @@ def iree_bitcode_library(
     clang_tool = "@llvm-project//clang:clang"
     link_tool = "@llvm-project//llvm:llvm-link"
     builtin_headers_dep = "@llvm-project//clang:builtin_headers_gen"
-    builtin_headers_path = "external/+_repo_rules+llvm-project/clang/staging/include/"
+    builtin_headers_path = Label("@llvm-project").workspace_root + "/clang/staging/include/"
 
     base_copts = [
         # Target architecture
@@ -126,9 +126,8 @@ def iree_bitcode_library(
                 " ".join([
                     "$(location %s)" % (clang_tool),
                     "-isystem $(BINDIR)/%s" % builtin_headers_path,
-                    " ".join(base_copts + copts),
-                    " ".join(["-I $(BINDIR)/runtime/src"]),
-                    " ".join(["-I runtime/src"]),
+                ] + base_copts + copts + [
+                    "-I %s/runtime/src" % Label("@iree_core").workspace_root,
                     "-o $(location %s)" % (bitcode_out),
                     "$(location %s)" % (src),
                 ]),
@@ -189,7 +188,6 @@ def iree_cuda_bitcode_library(
     clang_tool = "@llvm-project//clang:clang"
     link_tool = "@llvm-project//llvm:llvm-link"
     builtin_headers_dep = "@llvm-project//clang:builtin_headers_gen"
-    builtin_headers_path = "external/+_repo_rules+llvm-project/clang/staging/include/"
 
     base_copts = [
         "-x",
@@ -322,7 +320,7 @@ def iree_amdgpu_bitcode_library(
             "$(location %s)" % (clang_tool),
             "$(location %s)" % (src),
             "-o $(location %s)" % (out),
-            "-I .",
+            "-I %s" % Label("@iree_core").workspace_root,
         ] + base_copts + copts),
         tools = [
             clang_tool,
diff --git a/build_tools/bazel/iree_flatcc.bzl b/build_tools/bazel/iree_flatcc.bzl
index 73f89d387..3057b45dc 100644
--- a/build_tools/bazel/iree_flatcc.bzl
+++ b/build_tools/bazel/iree_flatcc.bzl
@@ -17,9 +17,15 @@ def iree_flatbuffer_c_library(
         **kwargs):
     flatcc = Label("@com_github_dvidelabs_flatcc//:flatcc")
 
+    # Extract the path from the //runtime/src:fbs_files label.
+    runtime_src_label = Label("//runtime/src:fbs_files")
+    runtime_src_path = runtime_src_label.package
+    if runtime_src_label.workspace_root:
+        runtime_src_path = runtime_src_label.workspace_root + "/" + runtime_src_path
+
     flags = [
         "-o$(RULEDIR)",
-        "-I runtime/src",
+        "-I " + runtime_src_path,
     ] + flatcc_args
 
     out_stem = "%s" % (srcs[0].replace(".fbs", ""))
@@ -38,7 +44,7 @@ def iree_flatbuffer_c_library(
 
     native.genrule(
         name = name + "_gen",
-        srcs = srcs + includes,
+        srcs = srcs + includes + ["//runtime/src:fbs_files"],
         outs = outs,
         tools = [flatcc],
         cmd = "$(location %s) %s %s" % (flatcc, " ".join(flags), " ".join(["$(location {})".format(src) for src in srcs])),
diff --git a/build_tools/bazel/renamed_link.bzl b/build_tools/bazel/renamed_link.bzl
index 820ba4cff..78e9b6569 100644
--- a/build_tools/bazel/renamed_link.bzl
+++ b/build_tools/bazel/renamed_link.bzl
@@ -361,8 +361,15 @@ def _renamed_cc_info_impl(ctx):
     linking_context = cc_common.create_linking_context(
         linker_inputs = depset(direct = linker_inputs, order = "topological"),
     )
+    runfiles = ctx.runfiles().merge_all([
+        dep[DefaultInfo].default_runfiles
+        for dep in ctx.attr.deps
+    ])
     return [
-        DefaultInfo(files = depset(renamed_files)),
+        DefaultInfo(
+            files = depset(renamed_files),
+            runfiles = runfiles,
+        ),
         CcInfo(linking_context = linking_context),
     ]
 
diff --git a/compiler/src/iree/compiler/API/BUILD.bazel b/compiler/src/iree/compiler/API/BUILD.bazel
index d63bd3832..accd510bc 100644
--- a/compiler/src/iree/compiler/API/BUILD.bazel
+++ b/compiler/src/iree/compiler/API/BUILD.bazel
@@ -60,6 +60,17 @@ iree_compiler_cc_library(
     tags = ["skip-bazel_to_cmake"],
 )
 
+iree_compiler_cc_library(
+    name = "ToolSharedImpl",
+    linkopts = select({
+        "@platforms//os:linux": ["-Wl,-rpath,$$ORIGIN/../lib"],
+        "@platforms//os:macos": ["-Wl,-rpath,@loader_path/../lib"],
+        "//conditions:default": [],
+    }),
+    tags = ["skip-bazel_to_cmake"],
+    deps = [":SharedImpl"],
+)
+
 # Shared by default, as in CMake: a dynamic plugin resolves against
 # libIREECompiler.
 bool_flag(
@@ -77,7 +88,7 @@ config_setting(
 alias(
     name = "Impl",
     actual = defaulting_select({
-        ":link_shared_config": ":SharedImpl",
+        ":link_shared_config": ":ToolSharedImpl",
         "//conditions:default": ":StaticImpl",
     }),
 )
diff --git a/runtime/src/BUILD.bazel b/runtime/src/BUILD.bazel
index 0198accac..d00648511 100644
--- a/runtime/src/BUILD.bazel
+++ b/runtime/src/BUILD.bazel
@@ -18,3 +18,8 @@ iree_cc_library(
         ".",
     ],
 )
+
+filegroup(
+    name = "fbs_files",
+    srcs = glob(["**/*.fbs"]),
+)
diff --git a/runtime/src/iree/vm/bytecode/isa/BUILD.bazel b/runtime/src/iree/vm/bytecode/isa/BUILD.bazel
index 86e833f73..6c8c86208 100644
--- a/runtime/src/iree/vm/bytecode/isa/BUILD.bazel
+++ b/runtime/src/iree/vm/bytecode/isa/BUILD.bazel
@@ -26,9 +26,9 @@ iree_genrule(
     outs = ["op_table.h"],
     cmd = " ".join([
         "python3",
-        "$(rootpath //build_tools/scripts:generate_vm_isa.py)",
+        "$(execpath //build_tools/scripts:generate_vm_isa.py)",
         "--schema",
-        "$(rootpath isa.json)",
+        "$(execpath isa.json)",
         "--op-table",
         "$(execpath op_table.h)",
     ]),
@@ -46,9 +46,9 @@ iree_genrule(
     ],
     cmd = " ".join([
         "python3",
-        "$(rootpath //build_tools/scripts:generate_vm_isa.py)",
+        "$(execpath //build_tools/scripts:generate_vm_isa.py)",
         "--schema",
-        "$(rootpath isa.json)",
+        "$(execpath isa.json)",
         "--encoding-table-header",
         "$(execpath encoding_table.h)",
         "--encoding-table-source",
-- 
