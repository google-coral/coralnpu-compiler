From 9c2459d946906f92df856aac84e2e7d79548d452 Mon Sep 17 00:00:00 2001
From: Shaked Flur <sflur@google.com>
Date: Sun, 27 Sep 2026 13:35:31 +0200
Subject: [PATCH] [PluginAPI] add pipeline extension hooks

---
 compiler/src/iree/compiler/Pipelines/Pipelines.cpp   |  7 +++++++
 compiler/src/iree/compiler/PluginAPI/Client.h        |  6 ++++++
 compiler/src/iree/compiler/PluginAPI/PluginManager.h | 12 ++++++++++++
 3 files changed, 25 insertions(+)

diff --git a/compiler/src/iree/compiler/Pipelines/Pipelines.cpp b/compiler/src/iree/compiler/Pipelines/Pipelines.cpp
index b3c61697f..7203931a6 100644
--- a/compiler/src/iree/compiler/Pipelines/Pipelines.cpp
+++ b/compiler/src/iree/compiler/Pipelines/Pipelines.cpp
@@ -378,6 +378,10 @@ void buildIREEVMTransformPassPipeline(
       }
       DispatchCreation::buildDispatchCreationPassPipeline(
           passManager, dispatchTransformOptions);
+      if (hooks.pipelineExtensions) {
+        hooks.pipelineExtensions->extendDispatchCreationPassPipeline(
+            passManager);
+      }
       if (hooks.afterPhase) {
         hooks.afterPhase(IREEVMPipelinePhase::DispatchCreation, passManager);
       }
@@ -410,6 +414,9 @@ void buildIREEVMTransformPassPipeline(
       }
       IREE::Stream::buildStreamTransformPassPipeline(passManager,
                                                      streamOptions);
+      if (hooks.pipelineExtensions) {
+        hooks.pipelineExtensions->extendStreamPassPipeline(passManager);
+      }
       if (hooks.afterPhase) {
         hooks.afterPhase(IREEVMPipelinePhase::Stream, passManager);
       }
diff --git a/compiler/src/iree/compiler/PluginAPI/Client.h b/compiler/src/iree/compiler/PluginAPI/Client.h
index 3c7ade966..5a5ad9a5d 100644
--- a/compiler/src/iree/compiler/PluginAPI/Client.h
+++ b/compiler/src/iree/compiler/PluginAPI/Client.h
@@ -81,6 +81,12 @@ public:
 
   // Adds passes to the |buildPreprocessingPassPipeline| pipeline at the end.
   virtual void extendPreprocessingPassPipeline(OpPassManager &passManager) {}
+
+  // Adds passes to the |buildDispatchCreationPassPipeline| pipeline at the end.
+  virtual void extendDispatchCreationPassPipeline(OpPassManager &passManager) {}
+
+  // Adds passes to the |buildStreamTransformPassPipeline| pipeline at the end.
+  virtual void extendStreamPassPipeline(OpPassManager &passManager) {}
 };
 
 // Policy for how to activate the plugin.
diff --git a/compiler/src/iree/compiler/PluginAPI/PluginManager.h b/compiler/src/iree/compiler/PluginAPI/PluginManager.h
index c249b3d73..2054cd68b 100644
--- a/compiler/src/iree/compiler/PluginAPI/PluginManager.h
+++ b/compiler/src/iree/compiler/PluginAPI/PluginManager.h
@@ -190,6 +190,18 @@ public:
     }
   }
 
+  void extendDispatchCreationPassPipeline(OpPassManager &passManager) override {
+    for (auto *s : initializedSessions) {
+      s->extendDispatchCreationPassPipeline(passManager);
+    }
+  }
+
+  void extendStreamPassPipeline(OpPassManager &passManager) override {
+    for (auto *s : initializedSessions) {
+      s->extendStreamPassPipeline(passManager);
+    }
+  }
+
   // Populates the given list of HAL target devices for all initialized
   // plugins.
   void populateHALTargetDevices(IREE::HAL::TargetDeviceList &list);
-- 
