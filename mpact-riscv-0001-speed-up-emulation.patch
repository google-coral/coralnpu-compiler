-    auto pc_val = state_->pc_operand()->AsUint64(0);
     if (state_->branch()) {
+      auto pc_val = state_->pc_operand()->AsUint64(0);
       state_->set_branch(false);
       AddToBranchTrace(pc, pc_val);
       next_pc = pc_val;
@@ -673,6 +680,45 @@ absl::StatusOr<size_t> RiscVTop::WriteMemory(uint64_t address,
   // Store bypassing any watch points/semihosting.
   state_->memory()->Store(address, db);
   db->DecRef();
+  // The host reloads dispatch code at address 0 between runs: keep a decode
+  // cache per ITCM .text image so repeated dispatches skip re-decoding, and
+  // only invalidate when a write overlaps the loaded code range.
+  constexpr uint64_t kItcmEnd = 0x00100000ULL;
+  if (address < kItcmEnd) {
+    if (address == 0 && length > 0 && length <= kItcmEnd) {
+      uint64_t h = 14695981039346656037ULL ^ length;
+      const auto* p = static_cast<const uint8_t*>(buffer);
+      size_t i = 0;
+      for (; i + 8 <= length; i += 8) {
+        uint64_t w;
+        std::memcpy(&w, p + i, sizeof(w));
+        h = (h ^ w) * 1099511628211ULL;
+      }
+      for (; i < length; ++i) {
+        h = (h ^ p[i]) * 1099511628211ULL;
+      }
+      auto it = itcm_decode_caches_.find(h);
+      if (it != itcm_decode_caches_.end()) {
+        rv_decode_cache_ = it->second;
+      } else if (decode_caches_.size() < 512) {
+        rv_decode_cache_ =
+            generic::DecodeCache::Create({16 * 1024, 2}, rv_decoder_);
+        decode_caches_.push_back(rv_decode_cache_);
+        itcm_decode_caches_.emplace(h, rv_decode_cache_);
+      } else {
+        // Reuse the active image's cache; that image must not find it again.
+        itcm_decode_caches_.erase(active_itcm_hash_);
+        rv_decode_cache_->InvalidateAll();
+        itcm_decode_caches_.emplace(h, rv_decode_cache_);
+      }
+      active_itcm_hash_ = h;
+      itcm_code_end_ = length;
+    } else if (address < itcm_code_end_) {
+      uint64_t end = std::min<uint64_t>(address + length, itcm_code_end_);
+      rv_decode_cache_->InvalidateRange(address, end);
+      itcm_decode_caches_.erase(active_itcm_hash_);
+    }
+  }
   return length;
 }
 
