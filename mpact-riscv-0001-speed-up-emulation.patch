     return tile_buffer_->size<uint8_t>();
   }
+  // Raw tile bytes; offsets come from GetPunningOffset().
+  auto tile_bytes() { return tile_buffer_->Get<uint8_t>(); }
 
   [[nodiscard]] ::mpact::sim::riscv::RiscVState* riscv_state() const {
     return state_;
