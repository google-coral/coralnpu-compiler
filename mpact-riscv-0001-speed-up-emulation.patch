+namespace {
+
+// Punning offsets of every (row, col) of `tile` at `tew` bits, computed once
+// per (tile edge, TEW, tile) and cached; -1 marks an invalid element.
+const int* TileOffsets(const RiscVZvtMatrixState* matrix_state, int tew,
+                       int tile) {
+  static auto* cache = new std::unordered_map<uint64_t, std::vector<int>>();
+  const int te = matrix_state->tile_elements();
+  const uint64_t key =
+      (static_cast<uint64_t>(te) << 32) | (static_cast<uint64_t>(tew) << 8) |
+      static_cast<uint64_t>(tile);
+  auto it = cache->find(key);
+  if (it == cache->end()) {
+    std::vector<int> offsets(te * te);
+    for (int row = 0; row < te; row++) {
+      for (int col = 0; col < te; col++) {
+        absl::StatusOr<int> offset =
+            matrix_state->GetPunningOffset(tile, row, col, tew);
+        offsets[row * te + col] = offset.ok() ? *offset : -1;
+      }
+    }
+    it = cache->emplace(key, std::move(offsets)).first;
+  }
+  return it->second.data();
+}
