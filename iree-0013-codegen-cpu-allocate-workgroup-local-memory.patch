From 6aaedd7b8a26c5b93395f8247eb7eca548ec8997 Mon Sep 17 00:00:00 2001
From: Shaked Flur <sflur@google.com>
Date: Thu, 15 Oct 2026 14:03:20 +0200
Subject: [PATCH] [codegen] use memref.alloc for CPU workgroup mem

cpuAllocationFn always created a memref.alloca, also for a buffer in
workgroup local memory. LLVMCPUAssignWorkgroupLocalMemoryPass rejects
such an alloca: it needs a memref.alloc with a static size in the entry
block of the function. So no path led from tensors (e.g. a
bufferization.alloc_tensor in workgroup local memory) to workgroup
local memory.

For workgroup local memory, hoist a memref.alloc with a static upper
bound to the entry block (hoistOneStaticallyBoundAllocation), and emit
an error if the size has no static upper bound. The other allocations
do not change. This is the same idea as gpuRequireMemSpaceAllocationFn,
which picks alloca or alloc from the memory space.

For a dynamic size, hoistOneStaticallyBoundAllocation<memref::AllocOp>
moved the insertion point of the builder to the function terminator to
create the dealloc, and did not restore it. Bufferization creates the
copy of an out-of-place buffer at this insertion point, so the copy
went to the end of the function and did not verify. The helper now
keeps the insertion point of the caller, as it already does for a
static size.
---
 .../compiler/Codegen/Common/CPU/Passes.cpp    |  17 +++
 .../compiler/Codegen/LLVMCPU/test/BUILD.bazel |   1 +
 .../Codegen/LLVMCPU/test/CMakeLists.txt       |   1 +
 .../bufferize_workgroup_local_memory.mlir     | 141 ++++++++++++++++++
 .../Codegen/Transforms/Transforms.cpp         |   9 +-
 5 files changed, 167 insertions(+), 2 deletions(-)
 create mode 100644 compiler/src/iree/compiler/Codegen/LLVMCPU/test/bufferize_workgroup_local_memory.mlir

diff --git a/compiler/src/iree/compiler/Codegen/Common/CPU/Passes.cpp b/compiler/src/iree/compiler/Codegen/Common/CPU/Passes.cpp
index 8bd7fa528..5e088885f 100644
--- a/compiler/src/iree/compiler/Codegen/Common/CPU/Passes.cpp
+++ b/compiler/src/iree/compiler/Codegen/Common/CPU/Passes.cpp
@@ -6,6 +6,7 @@
 
 #include "iree/compiler/Codegen/Common/CPU/Passes.h"
 #include "iree/compiler/Codegen/Common/Passes.h"
+#include "iree/compiler/Codegen/Dialect/Codegen/IR/IREECodegenAttrs.h"
 #include "iree/compiler/Codegen/Transforms/Transforms.h"
 #include "mlir/Dialect/Bufferization/IR/BufferizableOpInterface.h"
 #include "mlir/Dialect/MemRef/IR/MemRef.h"
@@ -24,6 +25,22 @@ static FailureOr<Value> cpuAllocationFn(OpBuilder &builder, Location loc,
                                         unsigned alignment) {
   auto funcOp =
       builder.getInsertionPoint()->getParentOfType<mlir::FunctionOpInterface>();
+  // Workgroup local memory is not on the stack: the runtime supplies it.
+  // LLVMCPUAssignWorkgroupLocalMemoryPass needs a memref.alloc with a static
+  // size in the entry block of the function.
+  if (isa_and_nonnull<IREE::Codegen::WorkgroupLocalMemoryAttr>(
+          memRefType.getMemorySpace())) {
+    std::optional<Value> hoistedAllocation;
+    if (funcOp) {
+      hoistedAllocation = hoistOneStaticallyBoundAllocation<memref::AllocOp>(
+          funcOp, builder, loc, memRefType, dynamicSizes, alignment);
+    }
+    if (!hoistedAllocation) {
+      return emitError(loc, "workgroup local memory allocations need a static "
+                            "upper bound on their size");
+    }
+    return hoistedAllocation.value();
+  }
   if (funcOp) {
     std::optional<Value> hoistedAllocation =
         hoistOneStaticallyBoundAllocation<memref::AllocaOp>(
