+        auto* data_db = db_factory.Allocate(xfer_len);
+        parent_->Load(src_addr, data_db, nullptr, nullptr);
+        parent_->Store(dst_addr, data_db);
+        data_db->DecRef();
+      }
+
+      desc_db->DecRef();
+      desc_addr = next_desc;
+    }
