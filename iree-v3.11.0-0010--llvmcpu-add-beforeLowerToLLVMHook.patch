+// Deliberately looser than isSupportedMatrixContraction() in the CoralNPU
+// plugin: it only decides whether to leave the contraction for that pass. See
+// the INVARIANT comment in CoralNPUTileSizeSelectionUtils.cpp.
+bool isZvtMatrixContraction(vector::ContractionOp op) {
+  auto accTy = dyn_cast<VectorType>(op.getAcc().getType());
+  if (!accTy || accTy.getRank() != 2 || accTy.getDimSize(0) % 16 != 0 ||
+      accTy.getDimSize(1) % 16 != 0) {
+    return false;
+  }
+  Value v = op.getLhs();
+  while (Operation *def = v.getDefiningOp()) {
+    if (isa<arith::ExtFOp, arith::ExtSIOp, arith::ExtUIOp, vector::BroadcastOp,
+            vector::ShapeCastOp, vector::ExtractStridedSliceOp>(def)) {
+      v = def->getOperand(0);
+    } else {
+      break;
+    }
+  }
+  Type elTy = isa<VectorType>(v.getType())
+                  ? cast<VectorType>(v.getType()).getElementType()
+                  : v.getType();
+  return elTy.isF32() || elTy.isInteger(8);
+}
+
 class LLVMCPUVirtualVectorLoweringPass
     : public impl::LLVMCPUVirtualVectorLoweringPassBase<
           LLVMCPUVirtualVectorLoweringPass> {
@@ -80,10 +105,20 @@ void LLVMCPUVirtualVectorLoweringPass::runOnOperation() {
       vector::populateVectorGatherToConditionalLoadPatterns(patterns);
     }
     vector::populateVectorGatherLoweringPatterns(patterns);
-    vector::populateVectorContractLoweringPatterns(
-        patterns, vectorTransformOptions.vectorContractLowering,
-        /*benefit=*/1,
-        /*disableOuterProductLowering=*/false);
+    bool hasZvtContract =
+        hasFeature(targetConfig, "+zvtbase") &&
+        funcOp
+            .walk([](vector::ContractionOp op) {
+              return isZvtMatrixContraction(op) ? WalkResult::interrupt()
+                                                : WalkResult::advance();
+            })
+            .wasInterrupted();
+    if (!hasZvtContract) {
+      vector::populateVectorContractLoweringPatterns(
+          patterns, vectorTransformOptions.vectorContractLowering,
+          /*benefit=*/1,
+          /*disableOuterProductLowering=*/false);
+    }
     // This pattern will transform vector loads whose elements are used in a
     // scalar fashion into scalar loads. This will let scalar loads to be folded
     // into broadcast/arithmetic operations and reduce register pressure.
