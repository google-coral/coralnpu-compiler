load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(
    ":rv32.bzl",
    "RV32_CLANG_FLAGS",
    "RV32_COPTS",
    "RV32_IREE_EXECUTABLE_LIBRARY_HDR",
    "RV32_IREE_INC",
)

package(default_visibility = ["//visibility:public"])

COMMON_LD_SUBSTITUTIONS = {
    "@@STACK_SIZE@@": "4096",
    "@@HEAP_LOCATION@@": "DTCM",
    "@@HEAP_SIZE_SPEC@@": ". = ORIGIN(DTCM) + LENGTH(DTCM) - STACK_SIZE;",
    "@@STACK_START_SPEC@@": "",
}

# Prepare base linker script template with memory symbols appended
genrule(
    name = "coralnpu_tcm_ld_tpl",
    srcs = ["@coralnpu_hw//toolchain:coralnpu_tcm.ld.tpl"],
    outs = ["coralnpu_tcm.ld.tpl"],
    cmd = """
        cat $< > $@
        cat << 'EOF' >> $@

__itcm_start = ORIGIN(ITCM);
__itcm_size = LENGTH(ITCM);
__dtcm_start = ORIGIN(DTCM);
__dtcm_size = LENGTH(DTCM);
EOF
    """,
)

# Generate linker script from template
expand_template(
    name = "coralnpu_tcm_ld",
    out = "coralnpu_tcm.ld",
    substitutions = COMMON_LD_SUBSTITUTIONS | {
        "@@ITCM_LENGTH@@": "8",
        "@@DTCM_ORIGIN@@": "0x00010000",
        "@@DTCM_LENGTH@@": "32",
    },
    template = ":coralnpu_tcm_ld_tpl",
)

# Generate highmem linker script from template
expand_template(
    name = "coralnpu_tcm_highmem_ld",
    out = "coralnpu_tcm_highmem.ld",
    substitutions = COMMON_LD_SUBSTITUTIONS | {
        "@@ITCM_LENGTH@@": "1024",
        "@@DTCM_ORIGIN@@": "0x00100000",
        "@@DTCM_LENGTH@@": "1024",
    },
    template = ":coralnpu_tcm_ld_tpl",
)

# Compile and archive coralnpu_crt using the local RV32 toolchain
genrule(
    name = "libcoralnpu_crt",
    srcs = [
        "@coralnpu_hw//toolchain/crt:crt.S",
        "@coralnpu_hw//toolchain/crt:coralnpu_start.S",
        "@coralnpu_hw//toolchain/crt:coralnpu_exceptions.cc",
        "@coralnpu_hw//toolchain/crt:cxx_guards.cc",
        "coralnpu_dma.h",
        "coralnpu_dma.c",
        "@rv32_toolchain//:all_files",
        "@rv32_toolchain//:bin/riscv32-unknown-elf-clang",
        "@rv32_toolchain//:bin/riscv32-unknown-elf-clang++",
        "@rv32_toolchain//:bin/riscv32-unknown-elf-ar",
    ],
    outs = ["libcoralnpu_crt.a"],
    cmd = """
        {clang} {clang_flags} {copts} -c $(execpath @coralnpu_hw//toolchain/crt:crt.S) -o crt.o
        {clang} {clang_flags} {copts} -c $(execpath @coralnpu_hw//toolchain/crt:coralnpu_start.S) -o coralnpu_start.o
        {clangxx} {clang_flags} {copts} -c $(execpath @coralnpu_hw//toolchain/crt:coralnpu_exceptions.cc) -o coralnpu_exceptions.o
        {clangxx} {clang_flags} {copts} -c $(execpath @coralnpu_hw//toolchain/crt:cxx_guards.cc) -o cxx_guards.o
        {clang} {clang_flags} {copts} -c $(execpath coralnpu_dma.c) -o coralnpu_dma.o
        {ar} rcs $@ crt.o coralnpu_start.o coralnpu_exceptions.o cxx_guards.o coralnpu_dma.o
    """.format(
        ar = "$(execpath @rv32_toolchain//:bin/riscv32-unknown-elf-ar)",
        clang = "$(execpath @rv32_toolchain//:bin/riscv32-unknown-elf-clang)",
        clang_flags = RV32_CLANG_FLAGS,
        clangxx = "$(execpath @rv32_toolchain//:bin/riscv32-unknown-elf-clang++)",
        copts = RV32_COPTS,
    ),
)

# Compile and archive coralnpu_iree using the local RV32 toolchain
genrule(
    name = "libcoralnpu_iree",
    srcs = [
        "coralnpu_main.c",
        "coralnpu_dispatch.h",
        "@rv32_toolchain//:all_files",
        "@rv32_toolchain//:bin/riscv32-unknown-elf-clang",
        "@rv32_toolchain//:bin/riscv32-unknown-elf-ar",
        RV32_IREE_EXECUTABLE_LIBRARY_HDR,
    ],
    outs = ["libcoralnpu_iree.a"],
    cmd = """
        {clang} {clang_flags} {copts} -I{iree_inc} -c $(execpath coralnpu_main.c) -o coralnpu_main.o
        {ar} rcs $@ coralnpu_main.o
    """.format(
        ar = "$(execpath @rv32_toolchain//:bin/riscv32-unknown-elf-ar)",
        clang = "$(execpath @rv32_toolchain//:bin/riscv32-unknown-elf-clang)",
        clang_flags = RV32_CLANG_FLAGS,
        copts = RV32_COPTS,
        iree_inc = RV32_IREE_INC,
    ),
)

# Guest-side consumers built outside cc_* rules (e.g. the rv32 genrules in
# //tests/dma) need the header file itself rather than the cc_library.
exports_files(["coralnpu_dma.h"])

# Header-only target for inclusion by host-side simulator runtime
cc_library(
    name = "coralnpu_dispatch_hdrs",
    hdrs = [
        "coralnpu_dispatch.h",
        "coralnpu_dma.h",
    ],
)

filegroup(
    name = "crt_files",
    srcs = [
        ":coralnpu_tcm.ld",
        ":coralnpu_tcm_highmem.ld",
        ":libcoralnpu_crt.a",
        ":libcoralnpu_iree.a",
    ],
)
