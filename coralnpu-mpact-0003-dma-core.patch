+  if (size > 0 && addr < 0x00200000u) {
+    uint64_t end = static_cast<uint64_t>(addr) + size;
+    saw_tcm_write_ = true;
+    // Default layout maps only [0, 0x2000) ITCM and [0x10000, 0x18000) DTCM
