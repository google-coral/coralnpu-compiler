From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lun Dong <lundong@google.com>
Date: Wed, 28 Oct 2026 00:00:00 -0700
Subject: [PATCH] Round narrow Zvt FP matmuls as CoralNPU does

CoralNPU rounds the exact sum of the TK BF16 products to odd, and the
exact sum of the accumulator and the dot product to odd for sources
narrower than FP32, raising OF once a sum reaches 2^128 (the widening
dot product then gives infinity, the accumulate FLT_MAX). vtfmm summed
in double instead, which loses the sticky bit of a term more than 2^53
below the other, so results were not bit-exact with the hardware. Round
both from their exact (TwoSum) sums without per-element host rounding
mode scopes:
- DoubleToFloatROD truncates and jams in integer arithmetic. It no
  longer depends on the compiler keeping the conversion inside the
  rounding-mode scope (a direct call returned a NaN for 2^128).
- TwoSum keeps the host mode when it already rounds to nearest and the
  operands are finite: it then raises only NX, which RiscVZvtMatmul
  discards. The host mode is probed once per instruction.
- AddROD widens the accumulator without raising NV for a signaling NaN.
---
diff --git a/riscv/riscv_instruction_helpers.h b/riscv/riscv_instruction_helpers.h
--- a/riscv/riscv_instruction_helpers.h
+++ b/riscv/riscv_instruction_helpers.h
@@ -772,15 +772,38 @@
 inline float DoubleToFloatROD(double d, RiscVFPState* fp_state) {
   if (!fp_state) return static_cast<float>(d);
 
-  ScopedFPRoundingMode scoped_rm(fp_state->host_fp_interface(),
-                                 FPRoundingMode::kRoundTowardsZero);
-  float f = static_cast<float>(d);
-  if (std::isfinite(d) && static_cast<double>(f) != d) {
-    uint32_t f_bits = 0;
-    std::memcpy(&f_bits, &f, sizeof(f));
+  // Truncate toward zero and jam the LSB in integer arithmetic: switching the
+  // host rounding mode for every matrix element dominated emulation time.
+  uint64_t d_bits = 0;
+  std::memcpy(&d_bits, &d, sizeof(d));
+  const int biased_exp = static_cast<int>((d_bits >> 52) & 0x7ff);
+  const int exp = biased_exp - 1023;
+  const uint64_t frac = d_bits & ((uint64_t{1} << 52) - 1);
+  uint32_t f_bits = static_cast<uint32_t>(d_bits >> 63) << 31;
+  if (biased_exp == 0x7ff) {
+    // Infinity, or a NaN quieted with the top payload bits kept.
+    f_bits |= 0x7f800000u;
+    if (frac != 0) f_bits |= 0x00400000u | static_cast<uint32_t>(frac >> 29);
+  } else if (biased_exp == 0 && frac == 0) {
+    // Zero keeps its sign.
+  } else if (exp < -149) {
+    // Below the smallest float (double subnormals included): inexact zero.
     f_bits |= 1;
-    std::memcpy(&f, &f_bits, sizeof(f));
+  } else if (exp > 127) {
+    f_bits |= 0x7f7fffffu;  // FLT_MAX, whose LSB is already set.
+  } else if (exp >= -126) {
+    f_bits |= (static_cast<uint32_t>(exp + 127) << 23) |
+              static_cast<uint32_t>(frac >> 29);
+    if ((frac & 0x1fffffffu) != 0) f_bits |= 1;
+  } else {
+    // Float subnormal: shift the significand out, keeping a sticky bit.
+    const uint64_t significand = (uint64_t{1} << 52) | frac;
+    const int shift = -126 - exp + 29;
+    f_bits |= static_cast<uint32_t>(significand >> shift);
+    if ((significand & ((uint64_t{1} << shift) - 1)) != 0) f_bits |= 1;
   }
+  float f = 0.0f;
+  std::memcpy(&f, &f_bits, sizeof(f));
   return f;
 }
 
