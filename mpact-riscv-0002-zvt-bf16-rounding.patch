diff --git a/riscv/test/riscv_zvt_instructions_test.cc b/riscv/test/riscv_zvt_instructions_test.cc
--- a/riscv/test/riscv_zvt_instructions_test.cc
+++ b/riscv/test/riscv_zvt_instructions_test.cc
@@ -4204,6 +4204,105 @@
