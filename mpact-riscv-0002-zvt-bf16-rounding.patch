 TEST_F(RiscVZvtInstructionsTest, MatmulFcsrNxExceptionInvarianceTrace) {
   ConfigureMatrixUnit(kMtwiden1, kVsew32, kVlmul1, /*vl=*/2, /*tk=*/1,
