 }
 
+TEST_F(RiscVZvtInstructionsTest, DoubleToFloatRODTruncatesAndJams) {
+  // Truncation toward zero with the LSB jammed when inexact, across the float
+  // normal, subnormal, underflow and overflow ranges.
+  const struct {
+    double d;
+    uint32_t bits;
+  } kCases[] = {
+      {0x1p-149, 0x00000001u},  // Smallest float, exact.
+      {0x1p-150, 0x00000001u},  // Below it: inexact zero.
+      {-0x1p-151, 0x80000001u},
+      {0x1p-1074, 0x00000001u},               // Double subnormal.
+      {0x1.8p-148, 0x00000003u},              // Subnormal, exact.
+      {0x1.4p-148, 0x00000003u},              // Subnormal, sticky bit.
+      {0x1p-126, 0x00800000u},                // Smallest normal float.
+      {0x1.fffffffffffffp-127, 0x007fffffu},  // Just below it.
+      {0x1.000002p0, 0x3f800001u},            // Exact, odd.
+      {0x1.000001p0, 0x3f800001u},            // Halfway: truncated, jammed.
+      {-0x1.000003p0, 0xbf800001u},
+      {0x1.fffffep127, 0x7f7fffffu},  // FLT_MAX, exact.
+      {0x1p128, 0x7f7fffffu},         // Overflow truncates to it.
+      {-0x1p1000, 0xff7fffffu},
+  };
+  for (const auto& c : kCases) {
+    EXPECT_EQ(absl::bit_cast<uint32_t>(DoubleToFloatROD(c.d, fp_state_.get())),
+              c.bits)
+        << c.d;
+  }
+  // A signaling NaN is quieted and keeps the top payload bits.
+  EXPECT_EQ(absl::bit_cast<uint32_t>(DoubleToFloatROD(
+                absl::bit_cast<double>(uint64_t{0x7ff4000020000000}),
+                fp_state_.get())),
+            0x7fe00001u);
+}
+
+TEST_F(RiscVZvtInstructionsTest, VtfmmAltTvvBf16RoundsToOddUnderDirectedFrm) {
+  // The exact (TwoSum) sums are taken under round-to-nearest whatever frm
+  // says; under the directed mode itself these results differ by an ulp.
+  const struct {
+    FPRoundingMode frm;
+    uint32_t acc, expected;
+    uint16_t a, b;
+  } kCases[] = {
+      {FPRoundingMode::kRoundUp, 0x92caf64au, 0x57e4efffu, 0xd304, 0xc45e},
+      {FPRoundingMode::kRoundDown, 0x1471b870u, 0xfb631bffu, 0x53be, 0xe719},
+  };
+  ConfigureMatrixUnit(kMtwiden2, kVsew16, kVlmul1, /*vl=*/1, /*tk=*/1,
+                      /*tm=*/1, /*vstart=*/0, /*vta=*/false, /*vma=*/false,
+                      /*altfmt=*/true);
+  AppendMatmulSources(/*reg_a=*/8, /*reg_b=*/16, /*dest_tile=*/0);
+  instruction_->set_semantic_function(&RiscVZvtVtfmmAlt);
+  for (const auto& c : kCases) {
+    fp_state_->fcsr()->Write(*c.frm << kFcsrFrmShift);
+    ASSERT_OK(
+        SetTileMatrix<float>(/*tile=*/0, {{absl::bit_cast<float>(c.acc)}}));
+    WriteVectorRegister<uint16_t>("v8", {c.a});
+    WriteVectorRegister<uint16_t>("v16", {c.b});
+
+    instruction_->Execute(nullptr);
+
+    ASSERT_OK_AND_ASSIGN(float result,
+                         GetTileElem<float>(/*tile=*/0, /*row=*/0, /*col=*/0));
+    EXPECT_EQ(absl::bit_cast<uint32_t>(result), c.expected);
+  }
+}
+
+TEST_F(RiscVZvtInstructionsTest, VtfmmAltTvvBf16NonFiniteRaisesNoFlags) {
+  // Non-finite accumulators and operands raise no flags: a signaling-NaN
+  // accumulator is widened in integer arithmetic, and infinities keep the
+  // exact sums inside their flag-discarding scope.
+  const struct {
+    uint32_t acc, expected;
+    uint16_t a, b;
+  } kCases[] = {
+      {0xff9d20e8u, 0xffdd20e8u, 0xe0a8, 0xa73f},  // Signaling-NaN accumulator.
+      {0x7f800000u, 0x7f800000u, 0x3f80, 0x3f80},  // Infinite accumulator.
+      {0x3f800000u, 0x7f800000u, 0x7f80, 0x3f80},  // Infinite operand.
+  };
+  ConfigureMatrixUnit(kMtwiden2, kVsew16, kVlmul1, /*vl=*/1, /*tk=*/1,
+                      /*tm=*/1, /*vstart=*/0, /*vta=*/false, /*vma=*/false,
+                      /*altfmt=*/true);
+  AppendMatmulSources(/*reg_a=*/8, /*reg_b=*/16, /*dest_tile=*/0);
+  instruction_->set_semantic_function(&RiscVZvtVtfmmAlt);
+  for (const auto& c : kCases) {
+    fp_state_->fcsr()->Write(0U);
+    ASSERT_OK(
+        SetTileMatrix<float>(/*tile=*/0, {{absl::bit_cast<float>(c.acc)}}));
+    WriteVectorRegister<uint16_t>("v8", {c.a});
+    WriteVectorRegister<uint16_t>("v16", {c.b});
+
+    instruction_->Execute(nullptr);
+
+    ASSERT_OK_AND_ASSIGN(float result,
+                         GetTileElem<float>(/*tile=*/0, /*row=*/0, /*col=*/0));
+    EXPECT_EQ(absl::bit_cast<uint32_t>(result), c.expected)
+        << std::hex << c.acc;
+    EXPECT_EQ(fp_state_->fcsr()->AsUint32(), 0U) << std::hex << c.acc;
+  }
+}
