diff --git a/llvm/lib/Target/RISCV/RISCVVSETVLIInfoAnalysis.cpp b/llvm/lib/Target/RISCV/RISCVVSETVLIInfoAnalysis.cpp
index ff2d8b09ed..8a88e18305 100644
--- a/llvm/lib/Target/RISCV/RISCVVSETVLIInfoAnalysis.cpp
+++ b/llvm/lib/Target/RISCV/RISCVVSETVLIInfoAnalysis.cpp
@@ -15,9 +15,16 @@
 #include "RISCVSubtarget.h"
 #include "llvm/CodeGen/LiveIntervals.h"

+#define DEBUG_TYPE "riscv-vsetvli"
+
 namespace llvm {
 namespace RISCV {

+static bool isZvtZero(unsigned Opcode);
+static bool isZvtMatMul(unsigned Opcode);
+static bool isZvtMemOp(unsigned Opcode);
+static bool isZvtMove(unsigned Opcode);
+
 /// Given a virtual register \p Reg, return the corresponding VNInfo for it.
 /// This will return nullptr if the virtual register is an implicit_def or
 /// if LiveIntervals is not available.
@@ -324,6 +331,12 @@ DemandedFields getDemanded(const MachineInstr &MI, const RISCVSubtarget *ST) {
   Res.TWiden = RISCVII::hasTWidenOp(MI.getDesc().TSFlags) ||
                RISCVInstrInfo::isXSfmmVectorConfigInstr(MI);

+  if (isZvtMatMul(MI.getOpcode()) || isZvtMemOp(MI.getOpcode()) ||
+      isZvtMove(MI.getOpcode()) || isZvtZero(MI.getOpcode())) {
+    Res.demandVTYPE();
+    Res.demandVL();
+  }
+
   return Res;
 }

@@ -402,9 +415,161 @@ static unsigned computeVLMAX(unsigned VLEN, unsigned SEW,
   return VLEN / SEW;
 }

+static bool isZvtZero(unsigned Opcode) {
+  return Opcode == RISCV::PseudoVTZERO;
+}
+
+static bool isZvtMatMul(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTFMM_F32_TVV:
+  case RISCV::PseudoVTFMM_F16_TVV:
+  case RISCV::PseudoVTFMM_ALT_TVV:
+  case RISCV::PseudoVTMMU_TVV:
+  case RISCV::PseudoVTMMS_TVV:
+    return true;
+  default:
+    return false;
+  }
+}
+
+static unsigned getZvtSEW(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTFMM_F32_TVV:
+    return 32;
+  case RISCV::PseudoVTFMM_F16_TVV:
+  case RISCV::PseudoVTFMM_ALT_TVV:
+    return 16;
+  case RISCV::PseudoVTMMU_TVV:
+  case RISCV::PseudoVTMMS_TVV:
+    return 8;
+  default:
+    llvm_unreachable("Unexpected Zvt opcode");
+  }
+}
+
+static bool isZvtMemOp(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTLE8:
+  case RISCV::PseudoVTSE8:
+  case RISCV::PseudoVTLE16:
+  case RISCV::PseudoVTSE16:
+  case RISCV::PseudoVTLE32:
+  case RISCV::PseudoVTSE32:
+  case RISCV::PseudoVTLE64:
+  case RISCV::PseudoVTSE64:
+    return true;
+  default:
+    return false;
+  }
+}
+
+static unsigned getZvtMemOpSEW(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTLE8:
+  case RISCV::PseudoVTSE8:
+    return 8;
+  case RISCV::PseudoVTLE16:
+  case RISCV::PseudoVTSE16:
+    return 16;
+  case RISCV::PseudoVTLE32:
+  case RISCV::PseudoVTSE32:
+    return 32;
+  case RISCV::PseudoVTLE64:
+  case RISCV::PseudoVTSE64:
+    return 64;
+  default:
+    llvm_unreachable("Unexpected Zvt mem opcode");
+  }
+}
+
+static bool isZvtMove(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTMV_V_T_E8:
+  case RISCV::PseudoVTMV_V_T_E16:
+  case RISCV::PseudoVTMV_V_T_E32:
+  case RISCV::PseudoVTMV_V_T_E64:
+  case RISCV::PseudoVTMV_T_V_E8:
+  case RISCV::PseudoVTMV_T_V_E16:
+  case RISCV::PseudoVTMV_T_V_E32:
+  case RISCV::PseudoVTMV_T_V_E64:
+    return true;
+  default:
+    return false;
+  }
+}
+
+static unsigned getZvtMoveSEW(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTMV_V_T_E8:
+  case RISCV::PseudoVTMV_T_V_E8:
+    return 8;
+  case RISCV::PseudoVTMV_V_T_E16:
+  case RISCV::PseudoVTMV_T_V_E16:
+    return 16;
+  case RISCV::PseudoVTMV_V_T_E32:
+  case RISCV::PseudoVTMV_T_V_E32:
+    return 32;
+  case RISCV::PseudoVTMV_V_T_E64:
+  case RISCV::PseudoVTMV_T_V_E64:
+    return 64;
+  default:
+    llvm_unreachable("Unexpected Zvt move opcode");
+  }
+}
+
 VSETVLIInfo
 RISCVVSETVLIInfoAnalysis::computeInfoForInstr(const MachineInstr &MI) const {
   VSETVLIInfo InstrInfo;
+
+  if (isZvtMatMul(MI.getOpcode())) {
+    unsigned SEW = getZvtSEW(MI.getOpcode());
+    LLVM_DEBUG(dbgs() << "ZVT: computeInfoForInstr for " << MI.getOpcode() << ", SEW=" << SEW << "\n");
+    RISCVVType::VLMUL VLMul = RISCVII::getLMul(MI.getDesc().TSFlags);
+    bool TailAgnostic = true;
+    bool MaskAgnostic = true;
+    unsigned TWiden = 0;
+    if (SEW == 32) TWiden = 1;
+    else if (SEW == 16) TWiden = 2;
+    else if (SEW == 8) TWiden = 4;
+    InstrInfo.setAVLVLMAX();
+    InstrInfo.setVTYPE(VLMul, SEW, TailAgnostic, MaskAgnostic, /*AltFmt*/ false, TWiden);
+    return InstrInfo;
+  }
+
+  if (isZvtZero(MI.getOpcode())) {
+    LLVM_DEBUG(dbgs() << "ZVT: computeInfoForInstr (Zero) for " << MI.getOpcode() << "\n");
+    RISCVVType::VLMUL VLMul = RISCVII::getLMul(MI.getDesc().TSFlags);
+    unsigned SEW = 32;
+    unsigned TWiden = 1;
+    bool TailAgnostic = true;
+    bool MaskAgnostic = true;
+    InstrInfo.setAVLVLMAX();
+    InstrInfo.setVTYPE(VLMul, SEW, TailAgnostic, MaskAgnostic, /*AltFmt*/ false, TWiden);
+    return InstrInfo;
+  }
+
+  if (isZvtMemOp(MI.getOpcode())) {
+    unsigned SEW = getZvtMemOpSEW(MI.getOpcode());
+    LLVM_DEBUG(dbgs() << "ZVT: computeInfoForInstr (MemOp) for " << MI.getOpcode() << ", SEW=" << SEW << "\n");
+    RISCVVType::VLMUL VLMul = RISCVVType::LMUL_1;
+    bool TailAgnostic = true;
+    bool MaskAgnostic = true;
+    InstrInfo.setAVLImm(4);
+    InstrInfo.setVTYPE(VLMul, SEW, TailAgnostic, MaskAgnostic, /*AltFmt*/ false, /*TWiden*/ 0);
+    return InstrInfo;
+  }
+
+  if (isZvtMove(MI.getOpcode())) {
+    unsigned SEW = getZvtMoveSEW(MI.getOpcode());
+    LLVM_DEBUG(dbgs() << "ZVT: computeInfoForInstr (Move) for " << MI.getOpcode() << ", SEW=" << SEW << "\n");
+    RISCVVType::VLMUL VLMul = RISCVVType::LMUL_1;
+    bool TailAgnostic = true;
+    bool MaskAgnostic = true;
+    InstrInfo.setAVLVLMAX();
+    InstrInfo.setVTYPE(VLMul, SEW, TailAgnostic, MaskAgnostic, /*AltFmt*/ false, /*TWiden*/ 0);
+    return InstrInfo;
+  }
+
   const uint64_t TSFlags = MI.getDesc().TSFlags;

   bool TailAgnostic = true;
diff --git a/llvm/include/llvm/IR/IntrinsicsRISCVZvt.td b/llvm/include/llvm/IR/IntrinsicsRISCVZvt.td
