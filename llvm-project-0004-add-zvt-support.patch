diff --git a/llvm/lib/Target/RISCV/RISCVFeatures.td b/llvm/lib/Target/RISCV/RISCVFeatures.td
index 01ab6054c5..e9b1d42b44 100644
--- a/llvm/lib/Target/RISCV/RISCVFeatures.td
+++ b/llvm/lib/Target/RISCV/RISCVFeatures.td
@@ -741,6 +741,74 @@ def HasStdExtZvfbfminOrZvfofp8min
                          "'Zvfbfmin' (Vector BF16 Converts) or "
                          "'Zvfofp8min' (Vector OFP8 Converts)">;

+//===----------------------------------------------------------------------===//
+// Vector Matrix Extension (Zvt)
+//===----------------------------------------------------------------------===//
+
+def FeatureStdExtZvtbase
+    : RISCVExtension<0, 3, "RISC-V Vector Matrix Extension Base",
+                     [FeatureStdExtZve32f]>;
+def HasStdExtZvtbase : Predicate<"Subtarget->hasStdExtZvtbase()">,
+                       AssemblerPredicate<(all_of FeatureStdExtZvtbase),
+                           "'Zvtbase' (RISC-V Vector Matrix Extension Base)">;
+
+def FeatureStdExtZvt8e
+    : RISCVExtension<0, 3, "RISC-V Vector Matrix Extension 8-bit Element",
+                     [FeatureStdExtZvtbase]>;
+def HasStdExtZvt8e : Predicate<"Subtarget->hasStdExtZvt8e()">,
+                     AssemblerPredicate<(all_of FeatureStdExtZvt8e),
+                         "'Zvt8e' (RISC-V Vector Matrix Extension 8-bit Element)">;
+
+def FeatureStdExtZvt16e
+    : RISCVExtension<0, 3, "RISC-V Vector Matrix Extension 16-bit Element",
+                     [FeatureStdExtZvtbase]>;
+def HasStdExtZvt16e : Predicate<"Subtarget->hasStdExtZvt16e()">,
+                      AssemblerPredicate<(all_of FeatureStdExtZvt16e),
+                          "'Zvt16e' (RISC-V Vector Matrix Extension 16-bit Element)">;
+
+def FeatureStdExtZvt64e
+    : RISCVExtension<0, 3, "RISC-V Vector Matrix Extension 64-bit Element",
+                     [FeatureStdExtZvtbase]>;
+def HasStdExtZvt64e : Predicate<"Subtarget->hasStdExtZvt64e()">,
+                      AssemblerPredicate<(all_of FeatureStdExtZvt64e),
+                          "'Zvt64e' (RISC-V Vector Matrix Extension 64-bit Element)">;
+
+def FeatureStdExtZvti8i32mm
+    : RISCVExtension<0, 3, "RISC-V Vector Matrix Extension Int8-Int32 Matrix Multiply",
+                     [FeatureStdExtZvtbase]>;
+def HasStdExtZvti8i32mm : Predicate<"Subtarget->hasStdExtZvti8i32mm()">,
+                          AssemblerPredicate<(all_of FeatureStdExtZvti8i32mm),
+                              "'Zvti8i32mm' (RISC-V Vector Matrix Extension Int8-Int32 Matrix Multiply)">;
+
+def FeatureStdExtZvtf8f32mm
+    : RISCVExtension<0, 3, "RISC-V Vector Matrix Extension FP8-FP32 Matrix Multiply",
+                     [FeatureStdExtZvtbase]>;
+def HasStdExtZvtf8f32mm : Predicate<"Subtarget->hasStdExtZvtf8f32mm()">,
+                          AssemblerPredicate<(all_of FeatureStdExtZvtf8f32mm),
+                              "'Zvtf8f32mm' (RISC-V Vector Matrix Extension FP8-FP32 Matrix Multiply)">;
+
+def FeatureStdExtZvtf16f32mm
+    : RISCVExtension<0, 3, "RISC-V Vector Matrix Extension FP16-FP32 Matrix Multiply",
+                     [FeatureStdExtZvtbase]>;
+def HasStdExtZvtf16f32mm : Predicate<"Subtarget->hasStdExtZvtf16f32mm()">,
+                           AssemblerPredicate<(all_of FeatureStdExtZvtf16f32mm),
+                               "'Zvtf16f32mm' (RISC-V Vector Matrix Extension FP16-FP32 Matrix Multiply)">;
+
+def FeatureStdExtZvtf32f32mm
+    : RISCVExtension<0, 3, "RISC-V Vector Matrix Extension FP32-FP32 Matrix Multiply",
+                     [FeatureStdExtZvtbase]>;
+def HasStdExtZvtf32f32mm : Predicate<"Subtarget->hasStdExtZvtf32f32mm()">,
+                           AssemblerPredicate<(all_of FeatureStdExtZvtf32f32mm),
+                               "'Zvtf32f32mm' (RISC-V Vector Matrix Extension FP32-FP32 Matrix Multiply)">;
+
+def HasZvtAnyFMM : Predicate<"Subtarget->hasStdExtZvtf16f32mm() || Subtarget->hasStdExtZvtf32f32mm()">,
+                   AssemblerPredicate<(any_of FeatureStdExtZvtf16f32mm, FeatureStdExtZvtf32f32mm),
+                       "either 'Zvtf16f32mm' or 'Zvtf32f32mm'">;
+
+def HasZvtAltFMM : Predicate<"Subtarget->hasStdExtZvtf8f32mm()">,
+                   AssemblerPredicate<(all_of FeatureStdExtZvtf8f32mm),
+                       "'Zvtf8f32mm'">;
+
 // Vector Cryptography and Bitmanip Extensions

