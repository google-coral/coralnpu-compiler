+static bool isZvtMatMul(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTFMM_F32_TVV:
+  case RISCV::PseudoVTFMM_F16_TVV:
+  case RISCV::PseudoVTFMM_ALT_TVV:
+  case RISCV::PseudoVTMMU_TVV:
+  case RISCV::PseudoVTMMS_TVV:
+    return true;
+  default:
+    return false;
+  }
+}
+
+static bool isZvtMemOp(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTLE8:
+  case RISCV::PseudoVTSE8:
+  case RISCV::PseudoVTLE16:
+  case RISCV::PseudoVTSE16:
+  case RISCV::PseudoVTLE32:
+  case RISCV::PseudoVTSE32:
+  case RISCV::PseudoVTLE64:
+  case RISCV::PseudoVTSE64:
+    return true;
+  default:
+    return false;
+  }
+}
+
+static bool isZvtMove(unsigned Opcode) {
+  switch (Opcode) {
+  case RISCV::PseudoVTMV_V_T_E8:
+  case RISCV::PseudoVTMV_V_T_E16:
+  case RISCV::PseudoVTMV_V_T_E32:
+  case RISCV::PseudoVTMV_V_T_E64:
+  case RISCV::PseudoVTMV_T_V_E8:
+  case RISCV::PseudoVTMV_T_V_E16:
+  case RISCV::PseudoVTMV_T_V_E32:
+  case RISCV::PseudoVTMV_T_V_E64:
+    return true;
+  default:
+    return false;
+  }
+}
+
 // Given an incoming state reaching MI, minimally modifies that state so that it
 // is compatible with MI. The resulting state is guaranteed to be semantically
 // legal for MI, but may not be the state requested by MI.
@@ -326,13 +371,27 @@ void RISCVInsertVSETVLI::transferBefore(VSETVLIInfo &Info,
     return;
   }

-  if (!RISCVII::hasSEWOp(MI.getDesc().TSFlags))
+  if (!RISCVII::hasSEWOp(MI.getDesc().TSFlags) && !isZvtMatMul(MI.getOpcode()) && !isZvtMemOp(MI.getOpcode()) && !isZvtMove(MI.getOpcode()))
     return;

   DemandedFields Demanded = getDemanded(MI, ST);

   const VSETVLIInfo NewInfo = VIA.computeInfoForInstr(MI);
   assert(NewInfo.isValid() && !NewInfo.isUnknown());
+  LLVM_DEBUG({
+    if (isZvtMatMul(MI.getOpcode()) || isZvtMemOp(MI.getOpcode()) || isZvtMove(MI.getOpcode())) {
+      dbgs() << "ZVT: transferBefore for " << MI.getOpcode() << "\n";
+      dbgs() << "  Info.isValid(): " << Info.isValid() << "\n";
+      if (Info.isValid() && !Info.isUnknown() && !Info.hasSEWLMULRatioOnly()) {
+        dbgs() << "  Info.SEW: " << Info.getSEW() << "\n";
+      } else {
+        dbgs() << "  Info is not fully valid\n";
+      }
+      dbgs() << "  NewInfo.SEW: " << NewInfo.getSEW() << "\n";
+      bool need = needVSETVLI(Demanded, NewInfo, Info);
+      dbgs() << "  needVSETVLI: " << need << "\n";
+    }
+  });
   if (Info.isValid() && !needVSETVLI(Demanded, NewInfo, Info))
     return;

@@ -560,7 +619,7 @@ void RISCVInsertVSETVLI::emitVSETVLIs(MachineBasicBlock &MBB) {
     }

     uint64_t TSFlags = MI.getDesc().TSFlags;
-    if (RISCVII::hasSEWOp(TSFlags)) {
+    if (RISCVII::hasSEWOp(TSFlags) || isZvtMatMul(MI.getOpcode()) || isZvtMemOp(MI.getOpcode()) || isZvtMove(MI.getOpcode())) {
       if (!PrevInfo.isCompatible(DemandedFields::all(), CurInfo, LIS)) {
         // If this is the first implicit state change, and the state change
         // requested can be proven to produce the same register contents, we
