+//===- IntrinsicsRISCVZvt.td - Zvt intrinsics ---------------*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file defines all of the Zvt (Vector Matrix Extension) intrinsics for RISC-V.
+//
+//===----------------------------------------------------------------------===//
+
+let TargetPrefix = "riscv" in {
+
+  // Zvt Configuration Intrinsics
+  // Output: (actual_set_dim)
+  // Input: (requested_dim)
+  class ZvtMSetIntrinsic
+      : DefaultAttrsIntrinsic<[llvm_anyint_ty], [LLVMMatchType<0>],
+                              [IntrNoMem, IntrHasSideEffects]>;
+
+  def int_riscv_zvt_msettn : ZvtMSetIntrinsic;
+  def int_riscv_zvt_msettm : ZvtMSetIntrinsic;
+  def int_riscv_zvt_msettk : ZvtMSetIntrinsic;
+
+  // msetmtype: writes mtype (rs1) and vtype (rs2)
+  // Output: ()
+  // Input: (mtype, vtype)
+  def int_riscv_zvt_msetmtype
+      : DefaultAttrsIntrinsic<[], [llvm_anyint_ty, LLVMMatchType<0>],
+                              [IntrNoMem, IntrHasSideEffects]>;
+
+  // Zvt Tile Load/Store
+  // Input: (tile_index_gpr, base_addr)
+  class ZvtTileLoadIntrinsic
+      : Intrinsic<[], [llvm_anyint_ty, llvm_ptr_ty],
+                  [IntrReadMem, IntrHasSideEffects], "", [], 1>;
+
+  class ZvtTileStoreIntrinsic
+      : DefaultAttrsIntrinsic<[], [llvm_anyint_ty, llvm_ptr_ty],
+                              [IntrWriteMem, IntrHasSideEffects]>;
+
+  def int_riscv_zvt_vtle8  : ZvtTileLoadIntrinsic;
+  def int_riscv_zvt_vtle16 : ZvtTileLoadIntrinsic;
+  def int_riscv_zvt_vtle32 : ZvtTileLoadIntrinsic;
+  def int_riscv_zvt_vtle64 : ZvtTileLoadIntrinsic;
+
+  def int_riscv_zvt_vtse8  : ZvtTileStoreIntrinsic;
+  def int_riscv_zvt_vtse16 : ZvtTileStoreIntrinsic;
+  def int_riscv_zvt_vtse32 : ZvtTileStoreIntrinsic;
+  def int_riscv_zvt_vtse64 : ZvtTileStoreIntrinsic;
+
+  // Zvt Tile Zero/Discard
+  // vtzero takes a static tile register, so we use ImmArg.
+  // Input: (tile_num_imm)
+  def int_riscv_zvt_vtzero : DefaultAttrsIntrinsic<[], [llvm_anyint_ty],
+                                                   [ImmArg<ArgIndex<0>>, IntrNoMem, IntrHasSideEffects]>;
+  def int_riscv_zvt_vtdiscard : DefaultAttrsIntrinsic<[], [], [IntrNoMem, IntrHasSideEffects]>;
+
+  // Zvt Tile Moves
+  // vtmv.v.t and vtmv.t.v take tile index in a GPR.
+  // Output: (vector_out)
+  // Input: (tile_index_gpr)
+  def int_riscv_zvt_vtmv_v_t
+      : DefaultAttrsIntrinsic<[llvm_anyvector_ty], [llvm_anyint_ty],
+                              [IntrNoMem]>;
+
+  // Output: ()
+  // Input: (tile_index_gpr, vector_in)
+  def int_riscv_zvt_vtmv_t_v
+      : DefaultAttrsIntrinsic<[], [llvm_anyint_ty, llvm_anyvector_ty],
+                              [IntrNoMem, IntrHasSideEffects]>;
+
+  // Zvt Matrix Multiply Intrinsics
+  // Matmul takes a static tile register (TR class), so we use ImmArg.
+  // Output: ()
+  // Input: (tile_num_imm, vector_A, vector_B)
+  class ZvtMatMulIntrinsic
+      : DefaultAttrsIntrinsic<[], [llvm_anyint_ty, llvm_anyvector_ty, llvm_anyvector_ty],
+                              [ImmArg<ArgIndex<0>>, IntrNoMem, IntrHasSideEffects]>;
+
+  def int_riscv_zvt_vtmmu_tvv : ZvtMatMulIntrinsic;
+  def int_riscv_zvt_vtmms_tvv : ZvtMatMulIntrinsic;
+  def int_riscv_zvt_vtfmm_tvv : ZvtMatMulIntrinsic;
+  def int_riscv_zvt_vtfmm_alt_tvv : ZvtMatMulIntrinsic;
+
+} // TargetPrefix = "riscv"
diff --git a/llvm/lib/Target/RISCV/RISCVInstrInfoZvt.td b/llvm/lib/Target/RISCV/RISCVInstrInfoZvt.td
new file mode 100644
index 0000000000..49f7254701
--- /dev/null
+++ b/llvm/lib/Target/RISCV/RISCVInstrInfoZvt.td
@@ -0,0 +1,395 @@
+//===-- RISCVInstrInfoZvt.td - RISC-V Vector Matrix Extension -*- tablegen -*-=//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This file describes the instructions of the RISC-V Vector Matrix Extension
+// (VME), i.e. the Zvt family of extensions, as defined by the draft spec v0.3
+// (zvt-20260427). These instructions are not yet upstream; they are added here
+// so the CoralNPU toolchain can assemble VME programs without raw .insn/.word
+// directives.
+//
+// The matrix tile operand (mtd) reuses the XSfmmbase tile registers (mt0-mt15,
+// register class TR), whose assembly names already match the VME spec. The tile
+// number occupies instruction bits [11:8]; matrix-multiply instructions place an
+// "alternate format" bit at [7], matching sim/coralnpu_zvt.bin_fmt.
+//
+//===----------------------------------------------------------------------===//
+
+//===----------------------------------------------------------------------===//
+// Configuration instructions (OP-V major opcode, funct3 = OPCFG).
+//===----------------------------------------------------------------------===//
+
+let hasSideEffects = 1, mayLoad = 0, mayStore = 0 in {
+// msetmtype rs1, rs2: write mtype = rs1 and vtype = rs2 (vl is cleared).
+class ZvtMSetMType<string opcodestr>
+    : RVInst<(outs), (ins GPR:$rs1, GPR:$rs2), opcodestr, "$rs1, $rs2", [],
+             InstFormatI> {
+  bits<5> rs1;
+  bits<5> rs2;
+
+  let Inst{31-25} = 0b1000001;
+  let Inst{24-20} = rs2;
+  let Inst{19-15} = rs1;
+  let Inst{14-12} = OPCFG.Value;
+  let Inst{11-7} = 0b00000;
+  let Inst{6-0} = OPC_OP_V.Value;
+
+  let Defs = [VTYPE, VL];
+}
+
+// msettn/msettm/msettk rd, rs1: set tn/tm/tk, returning the value in rd.
+class ZvtMSetSingle<bits<5> rs2val, string opcodestr>
+    : RVInst<(outs GPR:$rd), (ins GPR:$rs1), opcodestr, "$rd, $rs1", [],
+             InstFormatI> {
+  bits<5> rs1;
+  bits<5> rd;
+
+  let Inst{31-25} = 0b1000010;
+  let Inst{24-20} = rs2val;
+  let Inst{19-15} = rs1;
+  let Inst{14-12} = OPCFG.Value;
+  let Inst{11-7} = rd;
+  let Inst{6-0} = OPC_OP_V.Value;
+
+  let Defs = [VTYPE, VL];
+}
+} // hasSideEffects = 1
+
+//===----------------------------------------------------------------------===//
+// Tile <-> vector-register moves and tile zero/discard (OP-V, funct3 = OPMVX).
+//===----------------------------------------------------------------------===//
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 0 in
+class ZvtTileMove<bits<6> funct6, dag outs, dag ins, string opcodestr,
+                  string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatR> {
+  bits<5> rs2;
+  bits<5> rs1;
+  bits<5> vd;
+
+  let Inst{31-26} = funct6;
+  let Inst{25} = 1;
+  let Inst{24-20} = rs2;
+  let Inst{19-15} = rs1;
+  let Inst{14-12} = OPMVX.Value;
+  let Inst{11-7} = vd;
+  let Inst{6-0} = OPC_OP_V.Value;
+
+  let Uses = [VTYPE, VL];
+}
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 0 in
+class ZvtTileZero<string opcodestr>
+    : RVInst<(outs), (ins TR:$rd), opcodestr, "$rd", [], InstFormatR> {
+  bits<4> rd;
+
+  let Inst{31-26} = 0b010000;
+  let Inst{25} = 1;
+  let Inst{24-20} = 0b11110;
+  let Inst{19-15} = 0b00000;
+  let Inst{14-12} = OPMVX.Value;
+  let Inst{11-8} = rd;
+  let Inst{7} = 0;
+  let Inst{6-0} = OPC_OP_V.Value;
+
+  let Uses = [VTYPE, VL];
+}
+
+let hasSideEffects = 1, mayLoad = 0, mayStore = 0 in
+class ZvtTileDiscard<string opcodestr>
+    : RVInst<(outs), (ins), opcodestr, "", [], InstFormatR> {
+  let Inst{31-26} = 0b010000;
+  let Inst{25} = 1;
+  let Inst{24-20} = 0b11100;
+  let Inst{19-15} = 0b00000;
+  let Inst{14-12} = OPMVX.Value;
+  let Inst{11-7} = 0b00000;
+  let Inst{6-0} = OPC_OP_V.Value;
+}
+
+//===----------------------------------------------------------------------===//
+// Tile subset load/store to memory (LOAD-FP / STORE-FP, mew = 1, width = 111).
+// nf selects EEW: 000 -> 8, 001 -> 16, 010 -> 32, 011 -> 64.
+//===----------------------------------------------------------------------===//
+
+class ZvtTileMemOp<bits<3> nf, RISCVOpcode opcode, dag outs, dag ins,
+                   string opcodestr, string argstr>
+    : RVInst<outs, ins, opcodestr, argstr, [], InstFormatR> {
+  bits<5> rs2;
+  bits<5> rs1;
+
+  let Inst{31-29} = nf;
+  let Inst{28} = 1;                       // mew
+  let Inst{27-26} = MOPLDUnitStride.Value;
+  let Inst{25} = 1;                       // vm
+  let Inst{24-20} = rs2;
+  let Inst{19-15} = rs1;
+  let Inst{14-12} = 0b111;                // width
+  let Inst{11-7} = 0b00000;
+  let Inst{6-0} = opcode.Value;
+
+  let Uses = [VTYPE, VL];
+}
+
+let hasSideEffects = 0, mayLoad = 1, mayStore = 0 in
+class ZvtTileLoad<bits<3> nf, string opcodestr>
+    : ZvtTileMemOp<nf, OPC_LOAD_FP, (outs), (ins GPR:$rs2, GPRMemZeroOffset:$rs1),
+                   opcodestr, "$rs2, ${rs1}">;
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 1 in
+class ZvtTileStore<bits<3> nf, string opcodestr>
+    : ZvtTileMemOp<nf, OPC_STORE_FP, (outs), (ins GPR:$rs2, GPRMemZeroOffset:$rs1),
+                   opcodestr, "$rs2, ${rs1}">;
+
+//===----------------------------------------------------------------------===//
+// Matrix multiply C += A^T * B (OP-VE, funct6 = 111100). funct3 selects
+// integer (000) or floating-point (001); the alt bit (Inst[7]) selects the
+// alternate-datatype variant. The destination tile occupies Inst[11:8].
+//===----------------------------------------------------------------------===//
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 0 in
+class ZvtMatmul<bits<3> funct3, bit alt, RegisterClass vr_class, string opcodestr>
+    : RVInst<(outs), (ins TR:$rd, vr_class:$vs2, vr_class:$vs1), opcodestr,
+             "$rd, $vs2, $vs1", [], InstFormatR> {
+  bits<5> vs2;
+  bits<5> vs1;
+  bits<4> rd;
+
+  let Inst{31-26} = 0b111100;
+  let Inst{25} = 1;                 // vm
+  let Inst{24-20} = vs2;
+  let Inst{19-15} = vs1;
+  let Inst{14-12} = funct3;
+  let Inst{11-8} = rd;
+  let Inst{7} = alt;
+  let Inst{6-0} = OPC_OP_VE.Value;
+
+  let Uses = [VTYPE, VL];
+}
+
+//===----------------------------------------------------------------------===//
+// Instruction definitions.
+//===----------------------------------------------------------------------===//
+
+let DecoderNamespace = "Zvt" in {
+
+let Predicates = [HasStdExtZvtbase] in {
+  def MSETMTYPE : ZvtMSetMType<"msetmtype">;
+  def MSETTN    : ZvtMSetSingle<0b00000, "msettn">;
+  def MSETTM    : ZvtMSetSingle<0b00001, "msettm">;
+  def MSETTK    : ZvtMSetSingle<0b00010, "msettk">;
+
+  def VTMV_V_T : ZvtTileMove<0b010000, (outs VR:$vd), (ins GPR:$rs1),
+                             "vtmv.v.t", "$vd, $rs1"> {
+    let rs2 = 0b11111;
+  }
+  def VTMV_T_V : ZvtTileMove<0b010111, (outs), (ins GPR:$rs1, VR:$rs2),
+                             "vtmv.t.v", "$rs1, $rs2"> {
+    let vd = 0b00000;
+  }
+
+  def VTZERO    : ZvtTileZero<"vtzero">;
+  def VTDISCARD : ZvtTileDiscard<"vtdiscard">;
+
+  // TEW=32 loads/stores are part of the base extension.
+  def VTLE32 : ZvtTileLoad<0b010, "vtle32">;
+  def VTSE32 : ZvtTileStore<0b010, "vtse32">;
+} // Predicates = [HasStdExtZvtbase]
+
+let Predicates = [HasStdExtZvt8e] in {
+  def VTLE8 : ZvtTileLoad<0b000, "vtle8">;
+  def VTSE8 : ZvtTileStore<0b000, "vtse8">;
+}
+let Predicates = [HasStdExtZvt16e] in {
+  def VTLE16 : ZvtTileLoad<0b001, "vtle16">;
+  def VTSE16 : ZvtTileStore<0b001, "vtse16">;
+}
+let Predicates = [HasStdExtZvt64e] in {
+  def VTLE64 : ZvtTileLoad<0b011, "vtle64">;
+  def VTSE64 : ZvtTileStore<0b011, "vtse64">;
+}
+
+let Predicates = [HasStdExtZvti8i32mm] in {
+  def VTMMU_TVV : ZvtMatmul<0b000, 0, VR, "vtmmu.tvv">;
+  def VTMMS_TVV : ZvtMatmul<0b000, 1, VR, "vtmms.tvv">;
+}
+
+let Uses = [VTYPE, VL, FRM], mayRaiseFPException = true in {
+  let Predicates = [HasZvtAnyFMM] in
+    def VTFMM_TVV     : ZvtMatmul<0b001, 0, VR, "vtfmm.tvv">;
+  let Predicates = [HasZvtAltFMM] in
+    def VTFMM_ALT_TVV : ZvtMatmul<0b001, 1, VR, "vtfmm.alt.tvv">;
+}
+
+} // DecoderNamespace = "Zvt"
+
+//===----------------------------------------------------------------------===//
+// Pseudos and Patterns for Zvt
+//===----------------------------------------------------------------------===//
+
+class VPseudoZvt_TileLoad
+    : RISCVVPseudo<(outs), (ins GPR:$rs2, GPR:$rs1)> {
+  let mayLoad = 1;
+  let mayStore = 0;
+  let hasSideEffects = 1;
+  let Uses = [VTYPE, VL];
+}
+
+class VPseudoZvt_TileStore
+    : RISCVVPseudo<(outs), (ins GPR:$rs2, GPR:$rs1)> {
+  let mayLoad = 0;
+  let mayStore = 1;
+  let hasSideEffects = 1;
+  let Uses = [VTYPE, VL];
+}
+
+class VPseudoZvt_MatMul<RegisterClass mtd_class, RegisterClass vr_class>
+    : RISCVVPseudo<(outs), (ins mtd_class:$rd, vr_class:$vs2, vr_class:$vs1)> {
+  let mayLoad = 0;
+  let mayStore = 0;
+  let hasSideEffects = 1;
+  let Uses = [VTYPE, VL];
+}
+
+class VPseudoZvt_MatMul_FRM<RegisterClass mtd_class, RegisterClass vr_class>
+    : RISCVVPseudo<(outs), (ins mtd_class:$rd, vr_class:$vs2, vr_class:$vs1, vec_rm:$rm)> {
+  let mayLoad = 0;
+  let mayStore = 0;
+  let hasSideEffects = 1;
+  let Uses = [VTYPE, VL, FRM];
+  let HasRoundModeOp = 1;
+}
+
+class VPseudoZvt_TileMove_V_T<int sew>
+    : RISCVVPseudo<(outs VR:$vd), (ins GPR:$rs1)> {
+  let mayLoad = 0;
+  let mayStore = 0;
+  let hasSideEffects = 1;
+  let Uses = [VTYPE, VL];
+  let SEW = sew;
+}
+
+class VPseudoZvt_TileMove_T_V<int sew>
+    : RISCVVPseudo<(outs), (ins GPR:$rs1, VR:$rs2)> {
+  let mayLoad = 0;
+  let mayStore = 0;
+  let hasSideEffects = 1;
+  let Uses = [VTYPE, VL];
+  let SEW = sew;
+}
+
+class VPseudoZvt_TileZero
+    : RISCVVPseudo<(outs), (ins TR:$rd)> {
+  let mayLoad = 0;
+  let mayStore = 0;
+  let hasSideEffects = 1;
+  let Uses = [VTYPE, VL];
+}
+
+let Predicates = [HasStdExtZvtbase] in {
+  def PseudoVTLE32 : VPseudoZvt_TileLoad;
+  def PseudoVTSE32 : VPseudoZvt_TileStore;
+  def PseudoVTMV_V_T_E8  : VPseudoZvt_TileMove_V_T<8>;
+  def PseudoVTMV_V_T_E16 : VPseudoZvt_TileMove_V_T<16>;
+  def PseudoVTMV_V_T_E32 : VPseudoZvt_TileMove_V_T<32>;
+  def PseudoVTMV_V_T_E64 : VPseudoZvt_TileMove_V_T<64>;
+
+  def PseudoVTMV_T_V_E8  : VPseudoZvt_TileMove_T_V<8>;
+  def PseudoVTMV_T_V_E16 : VPseudoZvt_TileMove_T_V<16>;
+  def PseudoVTMV_T_V_E32 : VPseudoZvt_TileMove_T_V<32>;
+  def PseudoVTMV_T_V_E64 : VPseudoZvt_TileMove_T_V<64>;
+
+  def PseudoVTZERO   : VPseudoZvt_TileZero;
+  def PseudoVTDISCARD : RISCVVPseudo<(outs), (ins)> {
+    let hasSideEffects = 1;
+  }
+}
+
+let Predicates = [HasStdExtZvt8e] in {
+  def PseudoVTLE8 : VPseudoZvt_TileLoad;
+  def PseudoVTSE8 : VPseudoZvt_TileStore;
+}
+let Predicates = [HasStdExtZvt16e] in {
+  def PseudoVTLE16 : VPseudoZvt_TileLoad;
+  def PseudoVTSE16 : VPseudoZvt_TileStore;
+}
+let Predicates = [HasStdExtZvt64e] in {
+  def PseudoVTLE64 : VPseudoZvt_TileLoad;
+  def PseudoVTSE64 : VPseudoZvt_TileStore;
+}
+
+let Predicates = [HasStdExtZvti8i32mm] in {
+  def PseudoVTMMU_TVV : VPseudoZvt_MatMul<TR, VR>;
+  def PseudoVTMMS_TVV : VPseudoZvt_MatMul<TR, VR>;
+}
+
+let Predicates = [HasZvtAnyFMM] in {
+  def PseudoVTFMM_F32_TVV : VPseudoZvt_MatMul_FRM<TR, VRM4>;
+  def PseudoVTFMM_F16_TVV : VPseudoZvt_MatMul_FRM<TR, VRM2>;
+}
+let Predicates = [HasZvtAltFMM] in {
+  def PseudoVTFMM_ALT_TVV : VPseudoZvt_MatMul_FRM<TR, VRM4> {
+    let BaseInstr = VTFMM_ALT_TVV;
+  }
+}
+
+// Patterns
+class PatZvtTileLoad<Intrinsic intr, Instruction pseudo>
+    : Pat<(intr (XLenVT GPR:$rs2), (XLenVT GPR:$rs1)),
+          (pseudo (XLenVT GPR:$rs2), (XLenVT GPR:$rs1))>;
+
+class PatZvtTileStore<Intrinsic intr, Instruction pseudo>
+    : Pat<(intr (XLenVT GPR:$rs2), (XLenVT GPR:$rs1)),
+          (pseudo (XLenVT GPR:$rs2), (XLenVT GPR:$rs1))>;
+
+let Predicates = [HasStdExtZvtbase] in {
+  def : PatZvtTileLoad<int_riscv_zvt_vtle32, PseudoVTLE32>;
+  def : PatZvtTileStore<int_riscv_zvt_vtse32, PseudoVTSE32>;
+
+  def : Pat<(int_riscv_zvt_vtdiscard), (PseudoVTDISCARD)>;
+}
+
+let Predicates = [HasStdExtZvt8e] in {
+  def : PatZvtTileLoad<int_riscv_zvt_vtle8, PseudoVTLE8>;
+  def : PatZvtTileStore<int_riscv_zvt_vtse8, PseudoVTSE8>;
+}
+let Predicates = [HasStdExtZvt16e] in {
+  def : PatZvtTileLoad<int_riscv_zvt_vtle16, PseudoVTLE16>;
+  def : PatZvtTileStore<int_riscv_zvt_vtse16, PseudoVTSE16>;
+}
+let Predicates = [HasStdExtZvt64e] in {
+  def : PatZvtTileLoad<int_riscv_zvt_vtle64, PseudoVTLE64>;
+  def : PatZvtTileStore<int_riscv_zvt_vtse64, PseudoVTSE64>;
+}
+
+class PatZvtMSetSingle<Intrinsic intr, Instruction inst>
+    : Pat<(XLenVT (intr (XLenVT GPR:$rs1))),
+          (inst GPR:$rs1)>;
+
+let Predicates = [HasStdExtZvtbase] in {
+  def : PatZvtMSetSingle<int_riscv_zvt_msettn, MSETTN>;
+  def : PatZvtMSetSingle<int_riscv_zvt_msettm, MSETTM>;
+  def : PatZvtMSetSingle<int_riscv_zvt_msettk, MSETTK>;
+
+  def : Pat<(int_riscv_zvt_msetmtype (XLenVT GPR:$rs1), (XLenVT GPR:$rs2)),
+            (MSETMTYPE GPR:$rs1, GPR:$rs2)>;
+}
+
+class PatZvtTileMove_V_T<Intrinsic intr, Instruction pseudo, ValueType val_ty>
+    : Pat<(val_ty (intr (XLenVT GPR:$rs1))),
+          (pseudo (XLenVT GPR:$rs1))>;
+
+class PatZvtTileMove_T_V<Intrinsic intr, Instruction pseudo, ValueType val_ty>
+    : Pat<(intr (XLenVT GPR:$rs1), (val_ty VR:$rs2)),
+          (pseudo (XLenVT GPR:$rs1), (val_ty VR:$rs2))>;
+
+let Predicates = [HasStdExtZvtbase] in {
+  foreach vti = [VI8M1, VI16M1, VI32M1, VI64M1, VF16M1, VF32M1, VF64M1, VBF16M1] in {
+    def : PatZvtTileMove_V_T<int_riscv_zvt_vtmv_v_t, !cast<Instruction>("PseudoVTMV_V_T_E" # vti.SEW), vti.Vector>;
+    def : PatZvtTileMove_T_V<int_riscv_zvt_vtmv_t_v, !cast<Instruction>("PseudoVTMV_T_V_E" # vti.SEW), vti.Vector>;
+  }
+}
