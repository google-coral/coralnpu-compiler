diff --git a/llvm/lib/Target/RISCV/RISCVISelDAGToDAG.cpp b/llvm/lib/Target/RISCV/RISCVISelDAGToDAG.cpp
index 76ecd4fccf..9a81fe1e9b 100644
--- a/llvm/lib/Target/RISCV/RISCVISelDAGToDAG.cpp
+++ b/llvm/lib/Target/RISCV/RISCVISelDAGToDAG.cpp
@@ -2867,6 +2867,61 @@ void RISCVDAGToDAGISel::Select(SDNode *Node) {
       ReplaceNode(Node, NewNode);
       return;
     }
+    case Intrinsic::riscv_zvt_vtmmu_tvv:
+    case Intrinsic::riscv_zvt_vtmms_tvv:
+    case Intrinsic::riscv_zvt_vtfmm_tvv:
+    case Intrinsic::riscv_zvt_vtfmm_alt_tvv: {
+      bool HasFRM = false;
+      unsigned PseudoInst;
+      uint64_t TileNum = Node->getConstantOperandVal(2);
+      SDValue Op1 = Node->getOperand(3);
+      SDValue Op2 = Node->getOperand(4);
+      SDValue Chain = Node->getOperand(0);
+      switch (IntNo) {
+      case Intrinsic::riscv_zvt_vtmmu_tvv:
+        PseudoInst = RISCV::PseudoVTMMU_TVV;
+        break;
+      case Intrinsic::riscv_zvt_vtmms_tvv:
+        PseudoInst = RISCV::PseudoVTMMS_TVV;
+        break;
+      case Intrinsic::riscv_zvt_vtfmm_tvv:
+        if (Op1.getValueType() == MVT::nxv8f16) {
+          PseudoInst = RISCV::PseudoVTFMM_F16_TVV;
+        } else {
+          assert(Op1.getValueType() == MVT::nxv8f32);
+          PseudoInst = RISCV::PseudoVTFMM_F32_TVV;
+        }
+        HasFRM = true;
+        break;
+      case Intrinsic::riscv_zvt_vtfmm_alt_tvv:
+        PseudoInst = RISCV::PseudoVTFMM_ALT_TVV;
+        HasFRM = true;
+        break;
+      }
+
+      SmallVector<SDValue, 8> Operands(
+          {CurDAG->getRegister(getTileReg(TileNum), XLenVT), Op1, Op2});
+      if (HasFRM)
+        Operands.push_back(
+            CurDAG->getTargetConstant(RISCVFPRndMode::DYN, DL, XLenVT));
+      Operands.push_back(Chain);
+
+      auto *NewNode =
+          CurDAG->getMachineNode(PseudoInst, DL, Node->getVTList(), Operands);
+
+      ReplaceNode(Node, NewNode);
+      return;
+    }
+    case Intrinsic::riscv_zvt_vtzero: {
+      uint64_t TileNum = Node->getConstantOperandVal(2);
+      SDValue Chain = Node->getOperand(0);
+      auto *NewNode = CurDAG->getMachineNode(
+          RISCV::PseudoVTZERO, DL, Node->getVTList(),
+          {CurDAG->getRegister(getTileReg(TileNum), XLenVT), Chain});
+
+      ReplaceNode(Node, NewNode);
+      return;
+    }
     }
     break;
   }
