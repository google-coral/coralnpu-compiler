diff --git a/sim/riscv_zvt.bin_fmt b/sim/riscv_zvt.bin_fmt
new file mode 100644
index 0000000..dde5ca3
--- /dev/null
+++ b/sim/riscv_zvt.bin_fmt
@@ -0,0 +1,50 @@
