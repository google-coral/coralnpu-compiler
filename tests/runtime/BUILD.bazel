load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//crt:rv32.bzl", "coralnpu_rv32_elf")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

coralnpu_rv32_elf(
    name = "local_memory_size_firmware_elf",
    src = "local_memory_size_firmware.c",
    dispatch = True,
)

# Checks that a dispatch sees the local memory size from the runtime.
cc_test(
    name = "local_memory_size_test",
    srcs = ["local_memory_size_test.cc"],
    args = ["$(rootpath :local_memory_size_firmware.elf)"],
    data = [":local_memory_size_firmware.elf"],
    linkstatic = True,
    tags = [
        "ci",
        "driver=coralnpu",
        "simulator=mpact",
        "target=coralnpu",
    ],
    deps = [
        "//runtime/sim:simulation",
        "//runtime/sim:simulator",
        "//runtime/sim:simulator_mpact",
        "@iree_core//runtime/src/iree/base",
        "@iree_core//runtime/src/iree/hal/local:executable_library",
    ],
)

test_suite(
    name = "ci",
    tags = ["ci"],
)
