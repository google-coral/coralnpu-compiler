load("//tests:defs.bzl", "coralnpu_check_test")

package(default_visibility = ["//visibility:public"])

_MODELS = [
    "abs_f32_4_8",
    "add_i32_4_8-4_8",
    "matmul_f32_4_8-8_4",
    "matmul_i8_4_8-8_4",
]

[
    coralnpu_check_test(
        name = "%s_verilator_test" % model,
        timeout = "short",
        src = "%s.mlir" % model,
        compiler_flags = [
            "--iree-hal-target-device=coralnpu",
            "> /dev/null",
        ],
        simulator = "verilator",
        tags = ["ci"],
    )
    for model in _MODELS
]

test_suite(
    name = "ci",
    tags = ["ci"],
)
