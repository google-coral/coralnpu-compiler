    %m4_a = util.optimization_barrier %m4_a_cst : tensor<1x4x16x1xi16>
    %m4_b = util.optimization_barrier %m4_b_cst : tensor<1x4x16x1xi16>
    %m4_seed = util.optimization_barrier %m4_seed_cst : tensor<1x1x16x16xi32>
    %m4 = linalg.mmt4d ins(%m4_a, %m4_b : tensor<1x4x16x1xi16>, tensor<1x4x16x1xi16>) outs(%m4_seed : tensor<1x1x16x16xi32>) -> tensor<1x1x16x16xi32>
    %m4_exp = util.optimization_barrier %m4_exp_cst : tensor<1x1x16x16xi32>
    "check.expect_eq"(%m4, %m4_exp) : (tensor<1x1x16x16xi32>, tensor<1x1x16x16xi32>) -> ()
