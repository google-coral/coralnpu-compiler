load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@iree_core//build_tools/bazel:native_binary.bzl", "native_test")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//build_tools/bazel:bytecode_module.bzl", "coralnpu_bytecode_module")

package(default_visibility = ["//visibility:public"])

_FPGA_ENVS = {
    "LD_LIBRARY_PATH": "runtime/sim/fpga:../_main/runtime/sim/fpga:../coralnpu-compiler/runtime/sim/fpga",
}

_FPGA_DATA = [
    "//runtime/sim/fpga:libcoralnpu_simulator_fpga.so",
]

_CHECK_TESTS = [
    "add_i32",
    "matmul",
    "matmul_add",
    "matmul_weight",
    "medium_10dispatch_net",
    "mini_multi_dispatch",
]

# ==============================================================================
# Check Tests (Compile & Local FPGA Execution)
# ==============================================================================
[
    coralnpu_bytecode_module(
        name = "npu_compile_tests_%s_vmfb" % test_id,
        src = "%s.mlir" % test_id,
        flags = [
            "--iree-hal-target-device=coralnpu",
            "--coralnpu-dtcm-size-kb=1024",
            "--coralnpu-linker-script-path=$(execpath //crt:coralnpu_tcm_highmem.ld)",
            "> /dev/null",
        ],
        module_name = "%s.vmfb" % test_id,
        tags = ["ci"],
        deps = [
            "//crt:coralnpu_tcm_highmem.ld",
        ],
    )
    for test_id in _CHECK_TESTS
]

build_test(
    name = "npu_compile_tests",
    tags = ["ci"],
    targets = [":%s.vmfb" % test_id for test_id in _CHECK_TESTS],
)

[
    native_test(
        name = "npu_fpga_tests_%s" % test_id,
        timeout = "short",
        src = "@iree_core//tools:iree-check-module",
        args = [
            "--module=$(rootpath :%s.vmfb)" % test_id,
            "--device=coralnpu",
            "--simulator=fpga",
        ],
        data = [":%s.vmfb" % test_id] + _FPGA_DATA,
        env = _FPGA_ENVS,
        tags = [
            "driver=coralnpu",
            "exclusive",  # Serialize tests to avoid FTDI USB contention on a single board.
            "local",  # Disable sandbox so /dev/bus/usb FTDI devices are visible.
            "manual",  # Require explicit invocation since physical hardware is needed.
            "target=coralnpu",
        ],
    )
    for test_id in _CHECK_TESTS
]

test_suite(
    name = "npu_fpga_tests",
    tags = [
        "exclusive",
        "local",
        "manual",
    ],
    tests = [":npu_fpga_tests_%s" % test_id for test_id in _CHECK_TESTS],
)

# ==============================================================================
# MobileNetV2 (Export, Compile & Local FPGA Execution)
# ==============================================================================
genrule(
    name = "gen_mobilenet_v2_mlir",
    outs = ["mobilenet_v2.mlir"],
    cmd = """
        TMPDIR=$$(mktemp -d)
        mkdir -p $$TMPDIR/examples/mobilenetv2-jax-aot
        BUILD_WORKSPACE_DIRECTORY=$$TMPDIR $(execpath //examples/mobilenetv2-jax-aot:export_mobilenet)
        cp $$TMPDIR/examples/mobilenetv2-jax-aot/mobilenet_v2.mlir $@
        rm -rf $$TMPDIR
    """,
    tags = [
        "local",  # Allow reading cached Keras weights in ~/.keras
        "manual",
    ],
    tools = ["//examples/mobilenetv2-jax-aot:export_mobilenet"],
)

coralnpu_bytecode_module(
    name = "mobilenet_v2_compile_test_vmfb",
    src = ":mobilenet_v2.mlir",
    flags = [
        "--iree-hal-target-device=coralnpu",
        "--coralnpu-dtcm-size-kb=1024",
        "--coralnpu-linker-script-path=$(execpath //crt:coralnpu_tcm_highmem.ld)",
        "> /dev/null",
    ],
    module_name = "mobilenet_v2.vmfb",
    tags = ["manual"],
    deps = [
        "//crt:coralnpu_tcm_highmem.ld",
    ],
)

build_test(
    name = "mobilenet_v2_compile_test",
    tags = ["manual"],
    targets = [":mobilenet_v2.vmfb"],
)

native_test(
    name = "mobilenet_v2_fpga_test",
    timeout = "long",
    src = "@iree_core//tools:iree-run-module",
    args = [
        "--module=$(rootpath :mobilenet_v2.vmfb)",
        "--device=coralnpu",
        "--simulator=fpga",
        "--function=main",
        "--input=1x224x224x3xf32=0",
    ],
    data = [":mobilenet_v2.vmfb"] + _FPGA_DATA,
    env = _FPGA_ENVS,
    tags = [
        "exclusive",  # Serialize tests to avoid FTDI USB contention on a single board.
        "local",  # Disable sandbox so /dev/bus/usb FTDI devices are visible.
        "manual",  # Require explicit invocation since physical hardware is needed.
    ],
)

# ==============================================================================
# Standalone FPGA Package (fpga_tests.tar.gz)
# ==============================================================================
pkg_files(
    name = "fpga_pkg_bin",
    testonly = True,
    srcs = [
        "//tools:iree-check-module-static",
        "//tools:iree-run-module-static",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "bin",
    renames = {
        "//tools:iree-check-module-static": "iree-check-module",
        "//tools:iree-run-module-static": "iree-run-module",
    },
)

pkg_files(
    name = "fpga_pkg_check_tests",
    testonly = True,
    srcs = [":%s.vmfb" % test_id for test_id in _CHECK_TESTS],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "check_tests",
)

pkg_files(
    name = "fpga_pkg_models",
    testonly = True,
    srcs = [":mobilenet_v2.vmfb"],
    attributes = pkg_attributes(mode = "0644"),
    prefix = "models",
    tags = ["manual"],
)

bool_flag(
    name = "include_models",
    build_setting_default = False,
)

config_setting(
    name = "include_models_setting",
    flag_values = {":include_models": "True"},
)

pkg_tar(
    name = "fpga_tests_tar",
    testonly = True,
    srcs = [
        ":fpga_pkg_bin",
        ":fpga_pkg_check_tests",
    ] + select({
        ":include_models_setting": [":fpga_pkg_models"],
        "//conditions:default": [],
    }),
    out = "fpga_tests.tar.gz",
    extension = "tar.gz",
)

test_suite(
    name = "ci",
    tags = ["ci"],
)
