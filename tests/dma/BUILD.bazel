# Standalone CoralNPU DMA tests.
#
# Each guest test in GUEST_TESTS is a bare-metal riscv32 program linked against
# the CRT alone (no IREE dispatch firmware) and run on the MPACT simulator by
# dma_sim_runner, which reads a result word and the DMA event trace back from
# DDR. dma_dispatch_test goes through the HAL's simulator runtime instead.

load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//crt:rv32.bzl", "coralnpu_rv32_elf")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

GUEST_TESTS = [
    "dma_runtime_test",
    "dma_runtime_nowait_test",
    "dma_chain_test",
    "dma_double_buffer_test",
]

[
    coralnpu_rv32_elf(
        name = name + "_elf",
        src = name + ".c",
        hdrs = [
            "dma_test_common.h",
            "//crt:coralnpu_dma.h",
        ],
    )
    for name in GUEST_TESTS
]

RUNNER_DEPS = [
    "//crt:coralnpu_dispatch_hdrs",
    "//runtime/sim:simulator",
    "//runtime/sim:simulator_mpact",
]

RUNNER_TAGS = [
    "ci",
    "driver=coralnpu",
    "simulator=mpact",
    "target=coralnpu",
]

# Both directions, the busy guard, and the shape checks.
cc_test(
    name = "dma_runtime_test",
    srcs = [
        "dma_sim_runner.cc",
        "dma_test_common.h",
    ],
    args = [
        "$(rootpath :dma_runtime_test.elf)",
        "--expect",
        "D11A0000",
    ],
    data = [":dma_runtime_test.elf"],
    linkstatic = True,
    tags = RUNNER_TAGS,
    deps = RUNNER_DEPS,
)

# Asserts that omitting the wait is observable: the guest MUST see stale data.
# A pass here is what licenses trusting every other DMA result in the tree.
cc_test(
    name = "dma_runtime_nowait_test",
    srcs = [
        "dma_sim_runner.cc",
        "dma_test_common.h",
    ],
    args = [
        "$(rootpath :dma_runtime_nowait_test.elf)",
        "--expect",
        "D11B0040",
    ],
    data = [":dma_runtime_nowait_test.elf"],
    linkstatic = True,
    tags = RUNNER_TAGS,
    deps = RUNNER_DEPS,
)

# Gathers a strided 2D tile using one chained descriptor per row.
cc_test(
    name = "dma_chain_test",
    srcs = [
        "dma_sim_runner.cc",
        "dma_test_common.h",
    ],
    args = [
        "$(rootpath :dma_chain_test.elf)",
        "--expect",
        "D11C0000",
    ],
    data = [":dma_chain_test.elf"],
    linkstatic = True,
    tags = RUNNER_TAGS,
    deps = RUNNER_DEPS,
)

# Streams a series of tiles through a DTCM ping-pong double buffer (computing
# on `curr` while prefetching `next`) and writes the accumulated result back to
# DDR.
cc_test(
    name = "dma_double_buffer_test",
    srcs = [
        "dma_sim_runner.cc",
        "dma_test_common.h",
    ],
    args = [
        "$(rootpath :dma_double_buffer_test.elf)",
        "--expect",
        "D11E0000",
    ],
    data = [":dma_double_buffer_test.elf"],
    linkstatic = True,
    tags = RUNNER_TAGS,
    deps = RUNNER_DEPS,
)

# Dispatch firmware, linked like compiler/Target/CoralNPULinkerTool.cpp does.
coralnpu_rv32_elf(
    name = "dma_dispatch_test_elf",
    src = "dma_dispatch_test.c",
    hdrs = ["//crt:coralnpu_dma.h"],
    dispatch = True,
)

# Large HAL bindings and the DMA trace do not overlap.
cc_test(
    name = "dma_dispatch_test",
    srcs = ["dma_dispatch_runner.cc"],
    args = ["$(rootpath :dma_dispatch_test.elf)"],
    data = [":dma_dispatch_test.elf"],
    linkstatic = True,
    tags = RUNNER_TAGS,
    deps = RUNNER_DEPS + [
        "//runtime/sim:simulation",
        "@iree_core//runtime/src/iree/base",
        "@iree_core//runtime/src/iree/hal/local:executable_library",
    ],
)

test_suite(
    name = "ci",
    tags = ["ci"],
)
