module {
  func.func @"matmul_i32_120_256-256_300"() {
    %cst = arith.constant dense<""> : tensor<120x300xi32>
    %cst_0 = arith.constant dense<""> : tensor<256x300xi32>
    %c0_i32 = arith.constant 0 : i32
    %cst_1 = arith.constant dense<""> : tensor<120x256xi32>
    %0 = util.optimization_barrier %cst_1 : tensor<120x256xi32>
    %1 = util.optimization_barrier %cst_0 : tensor<256x300xi32>
    %2 = tensor.empty() : tensor<120x300xi32>
    %3 = linalg.fill ins(%c0_i32 : i32) outs(%2 : tensor<120x300xi32>) -> tensor<120x300xi32>
    %4 = linalg.matmul ins(%0, %1 : tensor<120x256xi32>, tensor<256x300xi32>) outs(%3 : tensor<120x300xi32>) -> tensor<120x300xi32>
    %5 = util.optimization_barrier %cst : tensor<120x300xi32>
    "check.expect_eq"(%4, %5) : (tensor<120x300xi32>, tensor<120x300xi32>) -> ()
    return
  }
}
