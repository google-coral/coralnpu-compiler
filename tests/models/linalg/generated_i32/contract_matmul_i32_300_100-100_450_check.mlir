#map = affine_map<(d0, d1, d2) -> (d0, d2)>
#map1 = affine_map<(d0, d1, d2) -> (d2, d1)>
#map2 = affine_map<(d0, d1, d2) -> (d0, d1)>
module {
  func.func @"contract_matmul_i32_300_100-100_450"() {
    %cst = arith.constant dense<""> : tensor<300x450xi32>
    %cst_0 = arith.constant dense<""> : tensor<100x450xi32>
    %c0_i32 = arith.constant 0 : i32
    %cst_1 = arith.constant dense<""> : tensor<300x100xi32>
    %0 = util.optimization_barrier %cst_1 : tensor<300x100xi32>
    %1 = util.optimization_barrier %cst_0 : tensor<100x450xi32>
    %2 = tensor.empty() : tensor<300x450xi32>
    %3 = linalg.fill ins(%c0_i32 : i32) outs(%2 : tensor<300x450xi32>) -> tensor<300x450xi32>
    %4 = linalg.contract indexing_maps = [#map, #map1, #map2] ins(%0, %1 : tensor<300x100xi32>, tensor<100x450xi32>) outs(%3 : tensor<300x450xi32>) -> tensor<300x450xi32>
    %5 = util.optimization_barrier %cst : tensor<300x450xi32>
    "check.expect_eq"(%4, %5) : (tensor<300x450xi32>, tensor<300x450xi32>) -> ()
    return
  }
}
