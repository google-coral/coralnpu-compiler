module {
  func.func @"quantized_matmul_i8_120_256-256_300"() {
    %cst = arith.constant dense<""> : tensor<120x300xi32>
    %cst_0 = arith.constant dense<""> : tensor<256x300xi8>
    %c-3_i32 = arith.constant -3 : i32
    %c2_i32 = arith.constant 2 : i32
    %c0_i32 = arith.constant 0 : i32
    %cst_1 = arith.constant dense<""> : tensor<120x256xi8>
    %0 = util.optimization_barrier %cst_1 : tensor<120x256xi8>
    %1 = util.optimization_barrier %cst_0 : tensor<256x300xi8>
    %2 = tensor.empty() : tensor<120x300xi32>
    %3 = linalg.fill ins(%c0_i32 : i32) outs(%2 : tensor<120x300xi32>) -> tensor<120x300xi32>
    %4 = linalg.quantized_matmul ins(%0, %1, %c2_i32, %c-3_i32 : tensor<120x256xi8>, tensor<256x300xi8>, i32, i32) outs(%3 : tensor<120x300xi32>) -> tensor<120x300xi32>
    %5 = util.optimization_barrier %cst : tensor<120x300xi32>
    "check.expect_eq"(%4, %5) : (tensor<120x300xi32>, tensor<120x300xi32>) -> ()
    return
  }
