module {
  func.func @"quantized_matmul_i8_300_100-100_450"() {
    %cst = arith.constant dense<""> : tensor<300x450xi32>
    %cst_0 = arith.constant dense<""> : tensor<100x450xi8>
    %c-3_i32 = arith.constant -3 : i32
    %c2_i32 = arith.constant 2 : i32
    %c0_i32 = arith.constant 0 : i32
    %cst_1 = arith.constant dense<""> : tensor<300x100xi8>
    %0 = util.optimization_barrier %cst_1 : tensor<300x100xi8>
    %1 = util.optimization_barrier %cst_0 : tensor<100x450xi8>
    %2 = tensor.empty() : tensor<300x450xi32>
    %3 = linalg.fill ins(%c0_i32 : i32) outs(%2 : tensor<300x450xi32>) -> tensor<300x450xi32>
    %4 = linalg.quantized_matmul ins(%0, %1, %c2_i32, %c-3_i32 : tensor<300x100xi8>, tensor<100x450xi8>, i32, i32) outs(%3 : tensor<300x450xi32>) -> tensor<300x450xi32>
    %5 = util.optimization_barrier %cst : tensor<300x450xi32>
    "check.expect_eq"(%4, %5) : (tensor<300x450xi32>, tensor<300x450xi32>) -> ()
    return
  }
}
