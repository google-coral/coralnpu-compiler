#map = affine_map<(d0, d1, d2) -> (d0, d2)>
#map1 = affine_map<(d0, d1, d2) -> (d2, d1)>
#map2 = affine_map<(d0, d1, d2) -> (d0, d1)>
module {
  func.func @"contract_matmul_i8_120_256-256_300"() {
    %cst = arith.constant dense<""> : tensor<120x300xi8>
    %cst_0 = arith.constant dense<""> : tensor<256x300xi8>
    %c0_i8 = arith.constant 0 : i8
    %cst_1 = arith.constant dense<""> : tensor<120x256xi8>
    %0 = util.optimization_barrier %cst_1 : tensor<120x256xi8>
    %1 = util.optimization_barrier %cst_0 : tensor<256x300xi8>
    %2 = tensor.empty() : tensor<120x300xi8>
    %3 = linalg.fill ins(%c0_i8 : i8) outs(%2 : tensor<120x300xi8>) -> tensor<120x300xi8>
    %4 = linalg.contract indexing_maps = [#map, #map1, #map2] ins(%0, %1 : tensor<120x256xi8>, tensor<256x300xi8>) outs(%3 : tensor<120x300xi8>) -> tensor<120x300xi8>
    %5 = util.optimization_barrier %cst : tensor<120x300xi8>
    "check.expect_eq"(%4, %5) : (tensor<120x300xi8>, tensor<120x300xi8>) -> ()
    return
  }
}
