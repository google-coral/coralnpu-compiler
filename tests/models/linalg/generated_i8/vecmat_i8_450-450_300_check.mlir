module {
  func.func @"vecmat_i8_450-450_300"() {
    %cst = arith.constant dense<""> : tensor<300xi8>
    %cst_0 = arith.constant dense<""> : tensor<450x300xi8>
    %c0_i8 = arith.constant 0 : i8
    %cst_1 = arith.constant dense<""> : tensor<450xi8>
    %0 = util.optimization_barrier %cst_1 : tensor<450xi8>
    %1 = util.optimization_barrier %cst_0 : tensor<450x300xi8>
    %2 = tensor.empty() : tensor<300xi8>
    %3 = linalg.fill ins(%c0_i8 : i8) outs(%2 : tensor<300xi8>) -> tensor<300xi8>
    %4 = linalg.vecmat ins(%0, %1 : tensor<450xi8>, tensor<450x300xi8>) outs(%3 : tensor<300xi8>) -> tensor<300xi8>
    %5 = util.optimization_barrier %cst : tensor<300xi8>
    "check.expect_eq"(%4, %5) : (tensor<300xi8>, tensor<300xi8>) -> ()
    return
  }
}
