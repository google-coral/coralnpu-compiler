module {
  func.func @"map_i16_120_256-120_256"() {
    %cst = arith.constant dense<""> : tensor<120x256xi16>
    %cst_0 = arith.constant dense<""> : tensor<120x256xi16>
    %0 = util.optimization_barrier %cst_0 : tensor<120x256xi16>
    %1 = util.optimization_barrier %cst_0 : tensor<120x256xi16>
    %2 = tensor.empty() : tensor<120x256xi16>
    %mapped = linalg.map { arith.addi {overflowFlags = #arith.overflow<none>} } ins(%0, %1 : tensor<120x256xi16>, tensor<120x256xi16>) outs(%2 : tensor<120x256xi16>)
    %3 = util.optimization_barrier %cst : tensor<120x256xi16>
    "check.expect_eq"(%mapped, %3) : (tensor<120x256xi16>, tensor<120x256xi16>) -> ()
    return
  }
}
