#map = affine_map<(d0, d1, d2) -> (d0, d2)>
#map1 = affine_map<(d0, d1, d2) -> (d2, d1)>
#map2 = affine_map<(d0, d1, d2) -> (d0, d1)>
module {
  func.func @"contract_matmul_i16_300_100-100_450"() {
    %cst = arith.constant dense<""> : tensor<300x450xi16>
    %cst_0 = arith.constant dense<""> : tensor<100x450xi16>
    %c0_i16 = arith.constant 0 : i16
    %cst_1 = arith.constant dense<""> : tensor<300x100xi16>
    %0 = util.optimization_barrier %cst_1 : tensor<300x100xi16>
    %1 = util.optimization_barrier %cst_0 : tensor<100x450xi16>
    %2 = tensor.empty() : tensor<300x450xi16>
    %3 = linalg.fill ins(%c0_i16 : i16) outs(%2 : tensor<300x450xi16>) -> tensor<300x450xi16>
    %4 = linalg.contract indexing_maps = [#map, #map1, #map2] ins(%0, %1 : tensor<300x100xi16>, tensor<100x450xi16>) outs(%3 : tensor<300x450xi16>) -> tensor<300x450xi16>
    %5 = util.optimization_barrier %cst : tensor<300x450xi16>
    "check.expect_eq"(%4, %5) : (tensor<300x450xi16>, tensor<300x450xi16>) -> ()
    return
  }
}
