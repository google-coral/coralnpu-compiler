module {
  func.func @"matmul_f32_120_256-256_300"() {
    %cst = arith.constant dense<""> : tensor<120x300xf32>
    %cst_0 = arith.constant dense<""> : tensor<256x300xf32>
    %cst_1 = arith.constant 0.000000e+00 : f32
    %cst_2 = arith.constant dense<""> : tensor<120x256xf32>
    %0 = util.optimization_barrier %cst_2 : tensor<120x256xf32>
    %1 = util.optimization_barrier %cst_0 : tensor<256x300xf32>
    %2 = tensor.empty() : tensor<120x300xf32>
    %3 = linalg.fill ins(%cst_1 : f32) outs(%2 : tensor<120x300xf32>) -> tensor<120x300xf32>
    %4 = linalg.matmul ins(%0, %1 : tensor<120x256xf32>, tensor<256x300xf32>) outs(%3 : tensor<120x300xf32>) -> tensor<120x300xf32>
    %5 = util.optimization_barrier %cst : tensor<120x300xf32>
    "check.expect_almost_eq"(%4, %5) {rtol = 9.99999997E-7 : f32} : (tensor<120x300xf32>, tensor<120x300xf32>) -> ()
    return
  }
}
