module {
  func.func @"conv_1d_f32_453-4"() {
    %cst = arith.constant dense<""> : tensor<450xf32>
    %cst_0 = arith.constant dense<[0.000000e+00, 1.000000e+00, 2.000000e+00, 3.000000e+00]> : tensor<4xf32>
    %cst_1 = arith.constant 0.000000e+00 : f32
    %cst_2 = arith.constant dense<""> : tensor<453xf32>
    %0 = util.optimization_barrier %cst_2 : tensor<453xf32>
    %1 = util.optimization_barrier %cst_0 : tensor<4xf32>
    %2 = tensor.empty() : tensor<450xf32>
    %3 = linalg.fill ins(%cst_1 : f32) outs(%2 : tensor<450xf32>) -> tensor<450xf32>
    %4 = linalg.conv_1d ins(%0, %1 : tensor<453xf32>, tensor<4xf32>) outs(%3 : tensor<450xf32>) -> tensor<450xf32>
    %5 = util.optimization_barrier %cst : tensor<450xf32>
    "check.expect_almost_eq"(%4, %5) {rtol = 9.99999997E-7 : f32} : (tensor<450xf32>, tensor<450xf32>) -> ()
