#map = affine_map<(d0, d1) -> (d0, d1)>
module {
  func.func @"dequant_matmul_f32_40_48-48_200"() {
    %cst = arith.constant dense<""> : tensor<40x200xf32>
    %cst_0 = arith.constant dense<""> : tensor<48x200xi8>
    %cst_1 = arith.constant 2.500000e-01 : f32
    %cst_2 = arith.constant 5.000000e-01 : f32
    %cst_3 = arith.constant 0.000000e+00 : f32
    %cst_4 = arith.constant dense<""> : tensor<40x48xi8>
    %0 = util.optimization_barrier %cst_4 : tensor<40x48xi8>
    %1 = util.optimization_barrier %cst_0 : tensor<48x200xi8>
    %2 = tensor.empty() : tensor<40x48xf32>
    %3 = linalg.generic {indexing_maps = [#map, #map], iterator_types = ["parallel", "parallel"]} ins(%0 : tensor<40x48xi8>) outs(%2 : tensor<40x48xf32>) {
    ^bb0(%in: i8, %out: f32):
      %10 = arith.sitofp %in : i8 to f32
      %11 = arith.mulf %10, %cst_2 : f32
      linalg.yield %11 : f32
    } -> tensor<40x48xf32>
    %4 = tensor.empty() : tensor<48x200xf32>
    %5 = linalg.generic {indexing_maps = [#map, #map], iterator_types = ["parallel", "parallel"]} ins(%1 : tensor<48x200xi8>) outs(%4 : tensor<48x200xf32>) {
    ^bb0(%in: i8, %out: f32):
      %10 = arith.sitofp %in : i8 to f32
      %11 = arith.mulf %10, %cst_1 : f32
      linalg.yield %11 : f32
    } -> tensor<48x200xf32>
    %6 = tensor.empty() : tensor<40x200xf32>
    %7 = linalg.fill ins(%cst_3 : f32) outs(%6 : tensor<40x200xf32>) -> tensor<40x200xf32>
    %8 = linalg.matmul ins(%3, %5 : tensor<40x48xf32>, tensor<48x200xf32>) outs(%7 : tensor<40x200xf32>) -> tensor<40x200xf32>
    %9 = util.optimization_barrier %cst : tensor<40x200xf32>
    "check.expect_almost_eq"(%8, %9) {rtol = 9.99999997E-7 : f32} : (tensor<40x200xf32>, tensor<40x200xf32>) -> ()
    return
  }
}
