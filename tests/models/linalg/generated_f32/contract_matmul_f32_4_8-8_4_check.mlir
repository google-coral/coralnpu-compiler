#map = affine_map<(d0, d1, d2) -> (d0, d2)>
#map1 = affine_map<(d0, d1, d2) -> (d2, d1)>
#map2 = affine_map<(d0, d1, d2) -> (d0, d1)>
module {
  func.func @"contract_matmul_f32_4_8-8_4"() {
    %cst = arith.constant dense<[[5.600000e+02, 5.880000e+02, 6.160000e+02, 6.440000e+02], [1.456000e+03, 1.548000e+03, 1.640000e+03, 1.732000e+03], [2.352000e+03, 2.508000e+03, 2.664000e+03, 2.820000e+03], [3.248000e+03, 3.468000e+03, 3.688000e+03, 3.908000e+03]]> : tensor<4x4xf32>
    %cst_0 = arith.constant dense<[[0.000000e+00, 1.000000e+00, 2.000000e+00, 3.000000e+00], [4.000000e+00, 5.000000e+00, 6.000000e+00, 7.000000e+00], [8.000000e+00, 9.000000e+00, 1.000000e+01, 1.100000e+01], [1.200000e+01, 1.300000e+01, 1.400000e+01, 1.500000e+01], [1.600000e+01, 1.700000e+01, 1.800000e+01, 1.900000e+01], [2.000000e+01, 2.100000e+01, 2.200000e+01, 2.300000e+01], [2.400000e+01, 2.500000e+01, 2.600000e+01, 2.700000e+01], [2.800000e+01, 2.900000e+01, 3.000000e+01, 3.100000e+01]]> : tensor<8x4xf32>
    %cst_1 = arith.constant 0.000000e+00 : f32
    %cst_2 = arith.constant dense<[[0.000000e+00, 1.000000e+00, 2.000000e+00, 3.000000e+00, 4.000000e+00, 5.000000e+00, 6.000000e+00, 7.000000e+00], [8.000000e+00, 9.000000e+00, 1.000000e+01, 1.100000e+01, 1.200000e+01, 1.300000e+01, 1.400000e+01, 1.500000e+01], [1.600000e+01, 1.700000e+01, 1.800000e+01, 1.900000e+01, 2.000000e+01, 2.100000e+01, 2.200000e+01, 2.300000e+01], [2.400000e+01, 2.500000e+01, 2.600000e+01, 2.700000e+01, 2.800000e+01, 2.900000e+01, 3.000000e+01, 3.100000e+01]]> : tensor<4x8xf32>
    %0 = util.optimization_barrier %cst_2 : tensor<4x8xf32>
    %1 = util.optimization_barrier %cst_0 : tensor<8x4xf32>
    %2 = tensor.empty() : tensor<4x4xf32>
    %3 = linalg.fill ins(%cst_1 : f32) outs(%2 : tensor<4x4xf32>) -> tensor<4x4xf32>
    %4 = linalg.contract indexing_maps = [#map, #map1, #map2] ins(%0, %1 : tensor<4x8xf32>, tensor<8x4xf32>) outs(%3 : tensor<4x4xf32>) -> tensor<4x4xf32>
    %5 = util.optimization_barrier %cst : tensor<4x4xf32>
    "check.expect_almost_eq"(%4, %5) {rtol = 9.99999997E-7 : f32} : (tensor<4x4xf32>, tensor<4x4xf32>) -> ()
    return
  }
}
