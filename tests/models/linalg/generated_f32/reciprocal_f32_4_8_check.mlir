module {
  func.func @reciprocal_f32_4_8() {
    %cst = arith.constant dense<[[0x7F800000, 1.000000e+00, 5.000000e-01, 0.333333343, 2.500000e-01, 2.000000e-01, 0.166666672, 0.142857149], [1.250000e-01, 0.111111112, 1.000000e-01, 0.0909090936, 0.0833333358, 0.0769230798, 0.0714285746, 0.0666666701], [6.250000e-02, 0.0588235296, 0.055555556, 0.0526315793, 5.000000e-02, 0.0476190485, 0.0454545468, 0.0434782617], [0.0416666679, 4.000000e-02, 0.0384615399, 0.0370370373, 0.0357142873, 0.0344827585, 0.0333333351, 0.0322580636]]> : tensor<4x8xf32>
    %cst_0 = arith.constant 1.000000e+00 : f32
    %cst_1 = arith.constant dense<[[0.000000e+00, 1.000000e+00, 2.000000e+00, 3.000000e+00, 4.000000e+00, 5.000000e+00, 6.000000e+00, 7.000000e+00], [8.000000e+00, 9.000000e+00, 1.000000e+01, 1.100000e+01, 1.200000e+01, 1.300000e+01, 1.400000e+01, 1.500000e+01], [1.600000e+01, 1.700000e+01, 1.800000e+01, 1.900000e+01, 2.000000e+01, 2.100000e+01, 2.200000e+01, 2.300000e+01], [2.400000e+01, 2.500000e+01, 2.600000e+01, 2.700000e+01, 2.800000e+01, 2.900000e+01, 3.000000e+01, 3.100000e+01]]> : tensor<4x8xf32>
    %0 = util.optimization_barrier %cst_1 : tensor<4x8xf32>
    %1 = tensor.empty() : tensor<4x8xf32>
    %2 = linalg.reciprocal ins(%0 : tensor<4x8xf32>) outs(%1 : tensor<4x8xf32>) -> tensor<4x8xf32>
    %3 = util.optimization_barrier %cst : tensor<4x8xf32>
    "check.expect_almost_eq"(%2, %3) {rtol = 9.99999997E-7 : f32} : (tensor<4x8xf32>, tensor<4x8xf32>) -> ()
    return
  }
}
