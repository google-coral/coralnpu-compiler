module {
  func.func @reduce_2d_dim0_f32_120_256() {
    %cst = arith.constant dense<""> : tensor<256xf32>
    %cst_0 = arith.constant 0.000000e+00 : f32
    %cst_1 = arith.constant dense<""> : tensor<120x256xf32>
    %0 = util.optimization_barrier %cst_1 : tensor<120x256xf32>
    %1 = tensor.empty() : tensor<256xf32>
    %2 = linalg.fill ins(%cst_0 : f32) outs(%1 : tensor<256xf32>) -> tensor<256xf32>
    %reduced = linalg.reduce ins(%0 : tensor<120x256xf32>) outs(%2 : tensor<256xf32>) dimensions = [0] 
      (%in: f32, %init: f32) {
        %4 = arith.addf %in, %init : f32
        linalg.yield %4 : f32
      }
    %3 = util.optimization_barrier %cst : tensor<256xf32>
    "check.expect_almost_eq"(%reduced, %3) {rtol = 9.99999997E-7 : f32} : (tensor<256xf32>, tensor<256xf32>) -> ()
    return
  }
}
