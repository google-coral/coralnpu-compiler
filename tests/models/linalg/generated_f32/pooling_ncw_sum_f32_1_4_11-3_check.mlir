module {
  func.func @"pooling_ncw_sum_f32_1_4_11-3"() {
    %cst = arith.constant dense<[[[3.000000e+00, 6.000000e+00, 9.000000e+00, 1.200000e+01, 1.500000e+01, 1.800000e+01, 2.100000e+01, 2.400000e+01, 2.700000e+01], [3.600000e+01, 3.900000e+01, 4.200000e+01, 4.500000e+01, 4.800000e+01, 5.100000e+01, 5.400000e+01, 5.700000e+01, 6.000000e+01], [6.900000e+01, 7.200000e+01, 7.500000e+01, 7.800000e+01, 8.100000e+01, 8.400000e+01, 8.700000e+01, 9.000000e+01, 9.300000e+01], [1.020000e+02, 1.050000e+02, 1.080000e+02, 1.110000e+02, 1.140000e+02, 1.170000e+02, 1.200000e+02, 1.230000e+02, 1.260000e+02]]]> : tensor<1x4x9xf32>
    %cst_0 = arith.constant dense<[0.000000e+00, 1.000000e+00, 2.000000e+00]> : tensor<3xf32>
    %cst_1 = arith.constant 0.000000e+00 : f32
    %cst_2 = arith.constant dense<[[[0.000000e+00, 1.000000e+00, 2.000000e+00, 3.000000e+00, 4.000000e+00, 5.000000e+00, 6.000000e+00, 7.000000e+00, 8.000000e+00, 9.000000e+00, 1.000000e+01], [1.100000e+01, 1.200000e+01, 1.300000e+01, 1.400000e+01, 1.500000e+01, 1.600000e+01, 1.700000e+01, 1.800000e+01, 1.900000e+01, 2.000000e+01, 2.100000e+01], [2.200000e+01, 2.300000e+01, 2.400000e+01, 2.500000e+01, 2.600000e+01, 2.700000e+01, 2.800000e+01, 2.900000e+01, 3.000000e+01, 3.100000e+01, 3.200000e+01], [3.300000e+01, 3.400000e+01, 3.500000e+01, 3.600000e+01, 3.700000e+01, 3.800000e+01, 3.900000e+01, 4.000000e+01, 4.100000e+01, 4.200000e+01, 4.300000e+01]]]> : tensor<1x4x11xf32>
    %0 = util.optimization_barrier %cst_2 : tensor<1x4x11xf32>
    %1 = util.optimization_barrier %cst_0 : tensor<3xf32>
    %2 = tensor.empty() : tensor<1x4x9xf32>
    %3 = linalg.fill ins(%cst_1 : f32) outs(%2 : tensor<1x4x9xf32>) -> tensor<1x4x9xf32>
    %4 = linalg.pooling_ncw_sum {dilations = dense<1> : vector<1xi64>, strides = dense<1> : vector<1xi64>} ins(%0, %1 : tensor<1x4x11xf32>, tensor<3xf32>) outs(%3 : tensor<1x4x9xf32>) -> tensor<1x4x9xf32>
    %5 = util.optimization_barrier %cst : tensor<1x4x9xf32>
    "check.expect_almost_eq"(%4, %5) {rtol = 9.99999997E-7 : f32} : (tensor<1x4x9xf32>, tensor<1x4x9xf32>) -> ()
    return
