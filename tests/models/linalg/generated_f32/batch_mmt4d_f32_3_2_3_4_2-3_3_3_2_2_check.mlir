    %1 = util.optimization_barrier %cst_0 : tensor<3x3x3x2x2xf32>
    %2 = tensor.empty() : tensor<3x2x3x4x2xf32>
    %3 = linalg.fill ins(%cst_1 : f32) outs(%2 : tensor<3x2x3x4x2xf32>) -> tensor<3x2x3x4x2xf32>
    %4 = linalg.batch_mmt4d ins(%0, %1 : tensor<3x2x3x4x2xf32>, tensor<3x3x3x2x2xf32>) outs(%3 : tensor<3x2x3x4x2xf32>) -> tensor<3x2x3x4x2xf32>
