module {
  func.func @pack_perm_bf16_8_16() {
    %cst = arith.constant dense<""> : tensor<1x1x8x16xbf16>
    %cst_0 = arith.constant dense<""> : tensor<8x16xbf16>
    %0 = util.optimization_barrier %cst_0 : tensor<8x16xbf16>
    %1 = tensor.empty() : tensor<1x1x8x16xbf16>
    %pack = linalg.pack %0 outer_dims_perm = [1, 0] inner_dims_pos = [0, 1] inner_tiles = [8, 16] into %1 : tensor<8x16xbf16> -> tensor<1x1x8x16xbf16>
