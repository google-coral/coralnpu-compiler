module {
  func.func @"conv_3d_bf16_7_7_7-3_3_3"() {
    %cst = arith.constant dense<""> : tensor<5x5x5xbf16>
    %cst_0 = arith.constant dense<[[[0.000000e+00, 1.000000e+00, 2.000000e+00], [3.000000e+00, 4.000000e+00, 5.000000e+00], [6.000000e+00, 7.000000e+00, 8.000000e+00]], [[9.000000e+00, 1.000000e+01, 1.100000e+01], [1.200000e+01, 1.300000e+01, 1.400000e+01], [1.500000e+01, 1.600000e+01, 1.700000e+01]], [[1.800000e+01, 1.900000e+01, 2.000000e+01], [2.100000e+01, 2.200000e+01, 2.300000e+01], [2.400000e+01, 2.500000e+01, 2.600000e+01]]]> : tensor<3x3x3xbf16>
    %cst_1 = arith.constant 0.000000e+00 : bf16
    %cst_2 = arith.constant dense<""> : tensor<7x7x7xbf16>
    %0 = util.optimization_barrier %cst_2 : tensor<7x7x7xbf16>
    %1 = util.optimization_barrier %cst_0 : tensor<3x3x3xbf16>
    %2 = tensor.empty() : tensor<5x5x5xbf16>
    %3 = linalg.fill ins(%cst_1 : bf16) outs(%2 : tensor<5x5x5xbf16>) -> tensor<5x5x5xbf16>
    %4 = linalg.conv_3d ins(%0, %1 : tensor<7x7x7xbf16>, tensor<3x3x3xbf16>) outs(%3 : tensor<5x5x5xbf16>) -> tensor<5x5x5xbf16>
    %5 = util.optimization_barrier %cst : tensor<5x5x5xbf16>
    "check.expect_almost_eq"(%4, %5) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<5x5x5xbf16>, tensor<5x5x5xbf16>) -> ()
    return
  }
