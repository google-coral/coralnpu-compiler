module {
  func.func @transpose_2d_bf16_300_450() {
    %cst = arith.constant dense<""> : tensor<450x300xbf16>
    %cst_0 = arith.constant dense<""> : tensor<300x450xbf16>
    %0 = util.optimization_barrier %cst_0 : tensor<300x450xbf16>
    %1 = tensor.empty() : tensor<450x300xbf16>
    %transposed = linalg.transpose ins(%0 : tensor<300x450xbf16>) outs(%1 : tensor<450x300xbf16>) permutation = [1, 0] 
    %2 = util.optimization_barrier %cst : tensor<450x300xbf16>
    "check.expect_almost_eq"(%transposed, %2) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<450x300xbf16>, tensor<450x300xbf16>) -> ()
    return
  }
}
