#map = affine_map<(d0, d1, d2) -> (d0, d2)>
#map1 = affine_map<(d0, d1, d2) -> (d2, d1)>
#map2 = affine_map<(d0, d1, d2) -> (d0, d1)>
module {
  func.func @"contract_matmul_bf16_300_100-100_450"() {
    %cst = arith.constant dense<""> : tensor<300x450xbf16>
    %cst_0 = arith.constant dense<""> : tensor<100x450xbf16>
    %cst_1 = arith.constant 0.000000e+00 : bf16
    %cst_2 = arith.constant dense<""> : tensor<300x100xbf16>
    %0 = util.optimization_barrier %cst_2 : tensor<300x100xbf16>
    %1 = util.optimization_barrier %cst_0 : tensor<100x450xbf16>
    %2 = tensor.empty() : tensor<300x450xbf16>
    %3 = linalg.fill ins(%cst_1 : bf16) outs(%2 : tensor<300x450xbf16>) -> tensor<300x450xbf16>
    %4 = linalg.contract indexing_maps = [#map, #map1, #map2] ins(%0, %1 : tensor<300x100xbf16>, tensor<100x450xbf16>) outs(%3 : tensor<300x450xbf16>) -> tensor<300x450xbf16>
    %5 = util.optimization_barrier %cst : tensor<300x450xbf16>
    "check.expect_almost_eq"(%4, %5) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<300x450xbf16>, tensor<300x450xbf16>) -> ()
    return
  }
}
