module {
  func.func @unpack_bf16_16_16_8_16() {
    %cst = arith.constant dense<""> : tensor<128x256xbf16>
    %cst_0 = arith.constant dense<""> : tensor<16x16x8x16xbf16>
    %0 = util.optimization_barrier %cst_0 : tensor<16x16x8x16xbf16>
    %1 = tensor.empty() : tensor<128x256xbf16>
    %unpack = linalg.unpack %0 inner_dims_pos = [0, 1] inner_tiles = [8, 16] into %1 : tensor<16x16x8x16xbf16> -> tensor<128x256xbf16>
    %2 = util.optimization_barrier %cst : tensor<128x256xbf16>
    "check.expect_almost_eq"(%unpack, %2) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<128x256xbf16>, tensor<128x256xbf16>) -> ()
    return
  }
}
