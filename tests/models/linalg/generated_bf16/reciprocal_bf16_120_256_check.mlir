module {
  func.func @reciprocal_bf16_120_256() {
    %cst = arith.constant dense<""> : tensor<120x256xbf16>
    %cst_0 = arith.constant 1.000000e+00 : bf16
    %cst_1 = arith.constant dense<""> : tensor<120x256xbf16>
    %0 = util.optimization_barrier %cst_1 : tensor<120x256xbf16>
    %1 = tensor.empty() : tensor<120x256xbf16>
    %2 = linalg.reciprocal ins(%0 : tensor<120x256xbf16>) outs(%1 : tensor<120x256xbf16>) -> tensor<120x256xbf16>
    %3 = util.optimization_barrier %cst : tensor<120x256xbf16>
    "check.expect_almost_eq"(%2, %3) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<120x256xbf16>, tensor<120x256xbf16>) -> ()
    return
  }
}
