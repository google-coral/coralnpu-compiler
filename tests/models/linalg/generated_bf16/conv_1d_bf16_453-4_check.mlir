module {
  func.func @"conv_1d_bf16_453-4"() {
    %cst = arith.constant dense<""> : tensor<450xbf16>
    %cst_0 = arith.constant dense<[0.000000e+00, 1.000000e+00, 2.000000e+00, 3.000000e+00]> : tensor<4xbf16>
    %cst_1 = arith.constant 0.000000e+00 : bf16
    %cst_2 = arith.constant dense<""> : tensor<453xbf16>
    %0 = util.optimization_barrier %cst_2 : tensor<453xbf16>
    %1 = util.optimization_barrier %cst_0 : tensor<4xbf16>
    %2 = tensor.empty() : tensor<450xbf16>
    %3 = linalg.fill ins(%cst_1 : bf16) outs(%2 : tensor<450xbf16>) -> tensor<450xbf16>
    %4 = linalg.conv_1d ins(%0, %1 : tensor<453xbf16>, tensor<4xbf16>) outs(%3 : tensor<450xbf16>) -> tensor<450xbf16>
    %5 = util.optimization_barrier %cst : tensor<450xbf16>
    "check.expect_almost_eq"(%4, %5) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<450xbf16>, tensor<450xbf16>) -> ()
    return
  }
}
