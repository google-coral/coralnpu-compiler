module {
  func.func @square_bf16_4_8() {
    %cst = arith.constant dense<[[0.000000e+00, 1.000000e+00, 4.000000e+00, 9.000000e+00, 1.600000e+01, 2.500000e+01, 3.600000e+01, 4.900000e+01], [6.400000e+01, 8.100000e+01, 1.000000e+02, 1.210000e+02, 1.440000e+02, 1.690000e+02, 1.960000e+02, 2.250000e+02], [2.560000e+02, 2.880000e+02, 3.240000e+02, 3.600000e+02, 4.000000e+02, 4.400000e+02, 4.840000e+02, 5.280000e+02], [5.760000e+02, 6.240000e+02, 6.760000e+02, 7.280000e+02, 7.840000e+02, 8.400000e+02, 9.000000e+02, 9.600000e+02]]> : tensor<4x8xbf16>
    %cst_0 = arith.constant dense<[[0.000000e+00, 1.000000e+00, 2.000000e+00, 3.000000e+00, 4.000000e+00, 5.000000e+00, 6.000000e+00, 7.000000e+00], [8.000000e+00, 9.000000e+00, 1.000000e+01, 1.100000e+01, 1.200000e+01, 1.300000e+01, 1.400000e+01, 1.500000e+01], [1.600000e+01, 1.700000e+01, 1.800000e+01, 1.900000e+01, 2.000000e+01, 2.100000e+01, 2.200000e+01, 2.300000e+01], [2.400000e+01, 2.500000e+01, 2.600000e+01, 2.700000e+01, 2.800000e+01, 2.900000e+01, 3.000000e+01, 3.100000e+01]]> : tensor<4x8xbf16>
    %0 = util.optimization_barrier %cst_0 : tensor<4x8xbf16>
    %1 = tensor.empty() : tensor<4x8xbf16>
    %2 = linalg.square ins(%0 : tensor<4x8xbf16>) outs(%1 : tensor<4x8xbf16>) -> tensor<4x8xbf16>
    %3 = util.optimization_barrier %cst : tensor<4x8xbf16>
    "check.expect_almost_eq"(%2, %3) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<4x8xbf16>, tensor<4x8xbf16>) -> ()
    return
  }
}
