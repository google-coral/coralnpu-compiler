module {
  func.func @pack_padding_bf16_120_250() {
    %cst = arith.constant dense<""> : tensor<15x16x8x16xbf16>
    %cst_0 = arith.constant 0.000000e+00 : bf16
    %cst_1 = arith.constant dense<""> : tensor<120x250xbf16>
    %0 = util.optimization_barrier %cst_1 : tensor<120x250xbf16>
    %1 = tensor.empty() : tensor<15x16x8x16xbf16>
    %pack = linalg.pack %0 padding_value(%cst_0 : bf16) inner_dims_pos = [0, 1] inner_tiles = [8, 16] into %1 : tensor<120x250xbf16> -> tensor<15x16x8x16xbf16>
    %2 = util.optimization_barrier %cst : tensor<15x16x8x16xbf16>
    "check.expect_almost_eq"(%pack, %2) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<15x16x8x16xbf16>, tensor<15x16x8x16xbf16>) -> ()
    return
  }
}
