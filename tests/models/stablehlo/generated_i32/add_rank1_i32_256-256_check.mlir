module {
  func.func @"add_rank1_i32_256-256"() {
    %cst = arith.constant dense<""> : tensor<256xi32>
    %cst_0 = arith.constant dense<""> : tensor<256xi32>
    %0 = util.optimization_barrier %cst_0 : tensor<256xi32>
    %1 = util.optimization_barrier %cst_0 : tensor<256xi32>
    %2 = stablehlo.add %0, %1 : tensor<256xi32>
    %3 = util.optimization_barrier %cst : tensor<256xi32>
    "check.expect_eq"(%2, %3) : (tensor<256xi32>, tensor<256xi32>) -> ()
    return
  }
}
