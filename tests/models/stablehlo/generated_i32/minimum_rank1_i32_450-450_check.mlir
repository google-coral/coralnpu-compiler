module {
  func.func @"minimum_rank1_i32_450-450"() {
    %cst = arith.constant dense<""> : tensor<450xi32>
    %0 = util.optimization_barrier %cst : tensor<450xi32>
    %1 = util.optimization_barrier %cst : tensor<450xi32>
    %2 = stablehlo.minimum %0, %1 : tensor<450xi32>
    %3 = util.optimization_barrier %cst : tensor<450xi32>
    "check.expect_eq"(%2, %3) : (tensor<450xi32>, tensor<450xi32>) -> ()
    return
  }
}
