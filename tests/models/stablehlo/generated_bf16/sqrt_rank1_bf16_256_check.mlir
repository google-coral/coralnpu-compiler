module {
  func.func @sqrt_rank1_bf16_256() {
    %cst = arith.constant dense<""> : tensor<256xbf16>
    %cst_0 = arith.constant dense<""> : tensor<256xbf16>
    %0 = util.optimization_barrier %cst_0 : tensor<256xbf16>
    %1 = stablehlo.sqrt %0 : tensor<256xbf16>
    %2 = util.optimization_barrier %cst : tensor<256xbf16>
    "check.expect_almost_eq"(%1, %2) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<256xbf16>, tensor<256xbf16>) -> ()
    return
  }
}
