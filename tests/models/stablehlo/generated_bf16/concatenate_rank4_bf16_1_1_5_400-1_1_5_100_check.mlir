module {
  func.func @"concatenate_rank4_bf16_1_1_5_400-1_1_5_100"() {
    %cst = arith.constant dense<""> : tensor<1x1x5x500xbf16>
    %cst_0 = arith.constant dense<""> : tensor<1x1x5x100xbf16>
    %cst_1 = arith.constant dense<""> : tensor<1x1x5x400xbf16>
    %0 = util.optimization_barrier %cst_1 : tensor<1x1x5x400xbf16>
    %1 = util.optimization_barrier %cst_0 : tensor<1x1x5x100xbf16>
    %2 = stablehlo.concatenate %0, %1, dim = 3 : (tensor<1x1x5x400xbf16>, tensor<1x1x5x100xbf16>) -> tensor<1x1x5x500xbf16>
    %3 = util.optimization_barrier %cst : tensor<1x1x5x500xbf16>
    "check.expect_almost_eq"(%2, %3) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<1x1x5x500xbf16>, tensor<1x1x5x500xbf16>) -> ()
    return
  }
}
