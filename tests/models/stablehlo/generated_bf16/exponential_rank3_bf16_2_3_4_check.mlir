module {
  func.func @exponential_rank3_bf16_2_3_4() {
    %cst = arith.constant dense<[[[1.000000e+00, 2.718750e+00, 7.375000e+00, 2.012500e+01], [5.450000e+01, 1.480000e+02, 4.040000e+02, 1.096000e+03], [2.976000e+03, 8.096000e+03, 2.201600e+04, 5.990400e+04]], [[1.628160e+05, 4.423680e+05, 1.204220e+06, 3.276800e+06], [8.912890e+06, 2.411720e+07, 6.553600e+07, 1.782580e+08], [4.844420e+08, 1.317010e+09, 3.590320e+09, 9.730780e+09]]]> : tensor<2x3x4xbf16>
    %cst_0 = arith.constant dense<[[[0.000000e+00, 1.000000e+00, 2.000000e+00, 3.000000e+00], [4.000000e+00, 5.000000e+00, 6.000000e+00, 7.000000e+00], [8.000000e+00, 9.000000e+00, 1.000000e+01, 1.100000e+01]], [[1.200000e+01, 1.300000e+01, 1.400000e+01, 1.500000e+01], [1.600000e+01, 1.700000e+01, 1.800000e+01, 1.900000e+01], [2.000000e+01, 2.100000e+01, 2.200000e+01, 2.300000e+01]]]> : tensor<2x3x4xbf16>
    %0 = util.optimization_barrier %cst_0 : tensor<2x3x4xbf16>
    %1 = stablehlo.exponential %0 : tensor<2x3x4xbf16>
    %2 = util.optimization_barrier %cst : tensor<2x3x4xbf16>
    "check.expect_almost_eq"(%1, %2) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<2x3x4xbf16>, tensor<2x3x4xbf16>) -> ()
    return
  }
}
