module {
  func.func @slice_rank4_bf16_2_2_3_4() {
    %cst = arith.constant dense<[[[[4.100000e+01, 4.200000e+01, 4.300000e+01], [4.500000e+01, 4.600000e+01, 4.700000e+01]]]]> : tensor<1x1x2x3xbf16>
    %cst_0 = arith.constant dense<[[[[0.000000e+00, 1.000000e+00, 2.000000e+00, 3.000000e+00], [4.000000e+00, 5.000000e+00, 6.000000e+00, 7.000000e+00], [8.000000e+00, 9.000000e+00, 1.000000e+01, 1.100000e+01]], [[1.200000e+01, 1.300000e+01, 1.400000e+01, 1.500000e+01], [1.600000e+01, 1.700000e+01, 1.800000e+01, 1.900000e+01], [2.000000e+01, 2.100000e+01, 2.200000e+01, 2.300000e+01]]], [[[2.400000e+01, 2.500000e+01, 2.600000e+01, 2.700000e+01], [2.800000e+01, 2.900000e+01, 3.000000e+01, 3.100000e+01], [3.200000e+01, 3.300000e+01, 3.400000e+01, 3.500000e+01]], [[3.600000e+01, 3.700000e+01, 3.800000e+01, 3.900000e+01], [4.000000e+01, 4.100000e+01, 4.200000e+01, 4.300000e+01], [4.400000e+01, 4.500000e+01, 4.600000e+01, 4.700000e+01]]]]> : tensor<2x2x3x4xbf16>
    %0 = util.optimization_barrier %cst_0 : tensor<2x2x3x4xbf16>
    %1 = stablehlo.slice %0 [1:2, 1:2, 1:3, 1:4] : (tensor<2x2x3x4xbf16>) -> tensor<1x1x2x3xbf16>
    %2 = util.optimization_barrier %cst : tensor<1x1x2x3xbf16>
    "check.expect_almost_eq"(%1, %2) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<1x1x2x3xbf16>, tensor<1x1x2x3xbf16>) -> ()
    return
  }
}
