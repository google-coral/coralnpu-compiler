    %1 = util.optimization_barrier %cst_0 : tensor<2x3x4x10xbf16>
    %2 = stablehlo.concatenate %0, %1, dim = 3 : (tensor<2x3x4x50xbf16>, tensor<2x3x4x10xbf16>) -> tensor<2x3x4x60xbf16>
