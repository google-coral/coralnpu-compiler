module {
  func.func @"multiply_rank1_bf16_450-450"() {
    %cst = arith.constant dense<""> : tensor<450xbf16>
    %cst_0 = arith.constant dense<""> : tensor<450xbf16>
    %0 = util.optimization_barrier %cst_0 : tensor<450xbf16>
    %1 = util.optimization_barrier %cst_0 : tensor<450xbf16>
    %2 = stablehlo.multiply %0, %1 : tensor<450xbf16>
    %3 = util.optimization_barrier %cst : tensor<450xbf16>
    "check.expect_almost_eq"(%2, %3) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<450xbf16>, tensor<450xbf16>) -> ()
    return
  }
}
