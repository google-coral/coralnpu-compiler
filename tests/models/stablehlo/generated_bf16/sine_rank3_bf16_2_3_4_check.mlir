module {
  func.func @sine_rank3_bf16_2_3_4() {
    %cst = arith.constant dense<[[[0.000000e+00, 8.398430e-01, 9.101560e-01, 1.416020e-01], [-7.578130e-01, -9.570310e-01, -2.792970e-01, 6.562500e-01], [9.882810e-01, 4.121090e-01, -5.429690e-01, -1.000000e+00]], [[-5.351560e-01, 4.199220e-01, 9.921870e-01, 6.484380e-01], [-2.871090e-01, -9.609370e-01, -7.500000e-01, 1.494140e-01], [9.140620e-01, 8.359380e-01, -8.850090e-03, -8.476560e-01]]]> : tensor<2x3x4xbf16>
    %cst_0 = arith.constant dense<[[[0.000000e+00, 1.000000e+00, 2.000000e+00, 3.000000e+00], [4.000000e+00, 5.000000e+00, 6.000000e+00, 7.000000e+00], [8.000000e+00, 9.000000e+00, 1.000000e+01, 1.100000e+01]], [[1.200000e+01, 1.300000e+01, 1.400000e+01, 1.500000e+01], [1.600000e+01, 1.700000e+01, 1.800000e+01, 1.900000e+01], [2.000000e+01, 2.100000e+01, 2.200000e+01, 2.300000e+01]]]> : tensor<2x3x4xbf16>
    %0 = util.optimization_barrier %cst_0 : tensor<2x3x4xbf16>
    %1 = stablehlo.sine %0 : tensor<2x3x4xbf16>
