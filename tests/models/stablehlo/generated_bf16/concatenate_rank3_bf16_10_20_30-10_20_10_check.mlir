module {
  func.func @"concatenate_rank3_bf16_10_20_30-10_20_10"() {
    %cst = arith.constant dense<""> : tensor<10x20x40xbf16>
    %cst_0 = arith.constant dense<""> : tensor<10x20x10xbf16>
    %cst_1 = arith.constant dense<""> : tensor<10x20x30xbf16>
    %0 = util.optimization_barrier %cst_1 : tensor<10x20x30xbf16>
    %1 = util.optimization_barrier %cst_0 : tensor<10x20x10xbf16>
    %2 = stablehlo.concatenate %0, %1, dim = 2 : (tensor<10x20x30xbf16>, tensor<10x20x10xbf16>) -> tensor<10x20x40xbf16>
    %3 = util.optimization_barrier %cst : tensor<10x20x40xbf16>
    "check.expect_almost_eq"(%2, %3) {atol = 0.00999999977 : f32, rtol = 0.00999999977 : f32} : (tensor<10x20x40xbf16>, tensor<10x20x40xbf16>) -> ()
    return
  }
}
