module {
  func.func @"power_rank1_i16_256-256"() {
    %cst = arith.constant dense<""> : tensor<256xi16>
    %cst_0 = arith.constant dense<""> : tensor<256xi16>
    %0 = util.optimization_barrier %cst_0 : tensor<256xi16>
    %1 = util.optimization_barrier %cst_0 : tensor<256xi16>
    %2 = stablehlo.power %0, %1 : tensor<256xi16>
    %3 = util.optimization_barrier %cst : tensor<256xi16>
    "check.expect_eq"(%2, %3) : (tensor<256xi16>, tensor<256xi16>) -> ()
    return
  }
}
