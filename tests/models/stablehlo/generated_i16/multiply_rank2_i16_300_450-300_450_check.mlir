module {
  func.func @"multiply_rank2_i16_300_450-300_450"() {
    %cst = arith.constant dense<""> : tensor<300x450xi16>
    %cst_0 = arith.constant dense<""> : tensor<300x450xi16>
    %0 = util.optimization_barrier %cst_0 : tensor<300x450xi16>
    %1 = util.optimization_barrier %cst_0 : tensor<300x450xi16>
    %2 = stablehlo.multiply %0, %1 : tensor<300x450xi16>
    %3 = util.optimization_barrier %cst : tensor<300x450xi16>
    "check.expect_eq"(%2, %3) : (tensor<300x450xi16>, tensor<300x450xi16>) -> ()
    return
  }
}
