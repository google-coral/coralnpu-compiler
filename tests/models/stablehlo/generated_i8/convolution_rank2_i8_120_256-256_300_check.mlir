module {
  func.func @"convolution_rank2_i8_120_256-256_300"() {
    %cst = arith.constant dense<""> : tensor<120x300xi8>
    %cst_0 = arith.constant dense<""> : tensor<256x300xi8>
    %cst_1 = arith.constant dense<""> : tensor<120x256xi8>
    %0 = util.optimization_barrier %cst_1 : tensor<120x256xi8>
    %1 = util.optimization_barrier %cst_0 : tensor<256x300xi8>
    %2 = stablehlo.convolution(%0, %1) dim_numbers = [b, f]x[i, o]->[b, f], window = {} {batch_group_count = 1 : i64, feature_group_count = 1 : i64} : (tensor<120x256xi8>, tensor<256x300xi8>) -> tensor<120x300xi8>
    %3 = util.optimization_barrier %cst : tensor<120x300xi8>
    "check.expect_eq"(%2, %3) : (tensor<120x300xi8>, tensor<120x300xi8>) -> ()
    return
  }
}
