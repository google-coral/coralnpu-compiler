module {
  func.func @"power_rank2_i8_120_256-120_256"() {
    %cst = arith.constant dense<""> : tensor<120x256xi8>
    %cst_0 = arith.constant dense<""> : tensor<120x256xi8>
    %0 = util.optimization_barrier %cst_0 : tensor<120x256xi8>
    %1 = util.optimization_barrier %cst_0 : tensor<120x256xi8>
    %2 = stablehlo.power %0, %1 : tensor<120x256xi8>
    %3 = util.optimization_barrier %cst : tensor<120x256xi8>
    "check.expect_eq"(%2, %3) : (tensor<120x256xi8>, tensor<120x256xi8>) -> ()
    return
  }
