module {
  func.func @"concatenate_rank2_i8_300_450-300_50"() {
    %cst = arith.constant dense<""> : tensor<300x500xi8>
    %cst_0 = arith.constant dense<""> : tensor<300x50xi8>
    %cst_1 = arith.constant dense<""> : tensor<300x450xi8>
    %0 = util.optimization_barrier %cst_1 : tensor<300x450xi8>
    %1 = util.optimization_barrier %cst_0 : tensor<300x50xi8>
    %2 = stablehlo.concatenate %0, %1, dim = 1 : (tensor<300x450xi8>, tensor<300x50xi8>) -> tensor<300x500xi8>
    %3 = util.optimization_barrier %cst : tensor<300x500xi8>
    "check.expect_eq"(%2, %3) : (tensor<300x500xi8>, tensor<300x500xi8>) -> ()
    return
  }
}
