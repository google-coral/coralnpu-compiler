    %0 = util.optimization_barrier %cst_1 : tensor<120x256xi8>
    %1 = util.optimization_barrier %cst_0 : tensor<120x100xi8>
    %2 = stablehlo.concatenate %0, %1, dim = 1 : (tensor<120x256xi8>, tensor<120x100xi8>) -> tensor<120x356xi8>
