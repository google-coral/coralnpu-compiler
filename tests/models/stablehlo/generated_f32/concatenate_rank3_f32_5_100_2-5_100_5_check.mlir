module {
  func.func @"concatenate_rank3_f32_5_100_2-5_100_5"() {
    %cst = arith.constant dense<""> : tensor<5x100x7xf32>
    %cst_0 = arith.constant dense<""> : tensor<5x100x5xf32>
    %cst_1 = arith.constant dense<""> : tensor<5x100x2xf32>
    %0 = util.optimization_barrier %cst_1 : tensor<5x100x2xf32>
    %1 = util.optimization_barrier %cst_0 : tensor<5x100x5xf32>
    %2 = stablehlo.concatenate %0, %1, dim = 2 : (tensor<5x100x2xf32>, tensor<5x100x5xf32>) -> tensor<5x100x7xf32>
    %3 = util.optimization_barrier %cst : tensor<5x100x7xf32>
    "check.expect_almost_eq"(%2, %3) {rtol = 9.99999997E-7 : f32} : (tensor<5x100x7xf32>, tensor<5x100x7xf32>) -> ()
    return
  }
}
