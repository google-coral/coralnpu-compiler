module {
  func.func @"add_rank2_f32_120_256-120_256"() {
    %cst = arith.constant dense<""> : tensor<120x256xf32>
    %cst_0 = arith.constant dense<""> : tensor<120x256xf32>
    %0 = util.optimization_barrier %cst_0 : tensor<120x256xf32>
    %1 = util.optimization_barrier %cst_0 : tensor<120x256xf32>
    %2 = stablehlo.add %0, %1 : tensor<120x256xf32>
    %3 = util.optimization_barrier %cst : tensor<120x256xf32>
    "check.expect_almost_eq"(%2, %3) {rtol = 9.99999997E-7 : f32} : (tensor<120x256xf32>, tensor<120x256xf32>) -> ()
    return
  }
}
