    %2 = util.optimization_barrier %cst : tensor<4x8xf32>
    "check.expect_almost_eq"(%1, %2) {rtol = 9.99999997E-7 : f32} : (tensor<4x8xf32>, tensor<4x8xf32>) -> ()
