module {
  func.func @"add_rank2_f32_300_450-300_450"() {
    %cst = arith.constant dense<""> : tensor<300x450xf32>
    %cst_0 = arith.constant dense<""> : tensor<300x450xf32>
    %0 = util.optimization_barrier %cst_0 : tensor<300x450xf32>
    %1 = util.optimization_barrier %cst_0 : tensor<300x450xf32>
    %2 = stablehlo.add %0, %1 : tensor<300x450xf32>
    %3 = util.optimization_barrier %cst : tensor<300x450xf32>
    "check.expect_almost_eq"(%2, %3) {rtol = 9.99999997E-7 : f32} : (tensor<300x450xf32>, tensor<300x450xf32>) -> ()
    return
  }
}
