module {
  func.func @rsqrt_rank4_f32_2_2_3_2() {
    %cst = arith.constant dense<[[[[0x7F800000, 1.000000e+00], [0.707106769, 0.577350259], [5.000000e-01, 0.44721359]], [[0.408248276, 0.377964497], [0.353553385, 0.333333343], [0.316227764, 0.301511347]]], [[[0.288675129, 0.277350098], [0.267261237, 0.258198887], [2.500000e-01, 0.242535636]], [[0.235702276, 0.22941573], [0.223606795, 0.21821788], [0.213200718, 0.208514407]]]]> : tensor<2x2x3x2xf32>
    %cst_0 = arith.constant dense<[[[[0.000000e+00, 1.000000e+00], [2.000000e+00, 3.000000e+00], [4.000000e+00, 5.000000e+00]], [[6.000000e+00, 7.000000e+00], [8.000000e+00, 9.000000e+00], [1.000000e+01, 1.100000e+01]]], [[[1.200000e+01, 1.300000e+01], [1.400000e+01, 1.500000e+01], [1.600000e+01, 1.700000e+01]], [[1.800000e+01, 1.900000e+01], [2.000000e+01, 2.100000e+01], [2.200000e+01, 2.300000e+01]]]]> : tensor<2x2x3x2xf32>
    %0 = util.optimization_barrier %cst_0 : tensor<2x2x3x2xf32>
    %1 = stablehlo.rsqrt %0 : tensor<2x2x3x2xf32>
    %2 = util.optimization_barrier %cst : tensor<2x2x3x2xf32>
    "check.expect_almost_eq"(%1, %2) {rtol = 9.99999997E-7 : f32} : (tensor<2x2x3x2xf32>, tensor<2x2x3x2xf32>) -> ()
    return
  }
}
