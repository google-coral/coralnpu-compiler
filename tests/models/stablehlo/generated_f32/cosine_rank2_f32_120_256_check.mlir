module {
  func.func @cosine_rank2_f32_120_256() {
    %cst = arith.constant dense<""> : tensor<120x256xf32>
    %cst_0 = arith.constant dense<""> : tensor<120x256xf32>
    %0 = util.optimization_barrier %cst_0 : tensor<120x256xf32>
    %1 = stablehlo.cosine %0 : tensor<120x256xf32>
    %2 = util.optimization_barrier %cst : tensor<120x256xf32>
    check.expect_almost_eq(%1, %2, atol 5.000000e-03, rtol 9.99999997E-7) : tensor<120x256xf32>
    return
  }
