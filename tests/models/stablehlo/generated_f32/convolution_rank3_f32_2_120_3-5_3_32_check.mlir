    %0 = util.optimization_barrier %cst_1 : tensor<2x120x3xf32>
    %1 = util.optimization_barrier %cst_0 : tensor<5x3x32xf32>
    %2 = stablehlo.convolution(%0, %1) dim_numbers = [b, 0, f]x[0, i, o]->[b, 0, f], window = {stride = [1], pad = [[0, 0]], lhs_dilate = [1], rhs_dilate = [1]} {batch_group_count = 1 : i64, feature_group_count = 1 : i64} : (tensor<2x120x3xf32>, tensor<5x3x32xf32>) -> tensor<2x116x32xf32>
