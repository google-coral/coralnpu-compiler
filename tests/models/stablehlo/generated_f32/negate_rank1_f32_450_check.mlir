module {
  func.func @negate_rank1_f32_450() {
    %cst = arith.constant dense<""> : tensor<450xf32>
    %cst_0 = arith.constant dense<""> : tensor<450xf32>
    %0 = util.optimization_barrier %cst_0 : tensor<450xf32>
    %1 = stablehlo.negate %0 : tensor<450xf32>
    %2 = util.optimization_barrier %cst : tensor<450xf32>
    "check.expect_almost_eq"(%1, %2) {rtol = 9.99999997E-7 : f32} : (tensor<450xf32>, tensor<450xf32>) -> ()
    return
  }
}
