module {
  func.func @"multiply_rank3_f32_10_20_30-10_20_30"() {
    %cst = arith.constant dense<""> : tensor<10x20x30xf32>
    %cst_0 = arith.constant dense<""> : tensor<10x20x30xf32>
    %0 = util.optimization_barrier %cst_0 : tensor<10x20x30xf32>
    %1 = util.optimization_barrier %cst_0 : tensor<10x20x30xf32>
    %2 = stablehlo.multiply %0, %1 : tensor<10x20x30xf32>
    %3 = util.optimization_barrier %cst : tensor<10x20x30xf32>
    "check.expect_almost_eq"(%2, %3) {rtol = 9.99999997E-7 : f32} : (tensor<10x20x30xf32>, tensor<10x20x30xf32>) -> ()
    return
  }
}
