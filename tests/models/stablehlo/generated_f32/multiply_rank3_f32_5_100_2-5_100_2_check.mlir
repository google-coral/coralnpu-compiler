module {
  func.func @"multiply_rank3_f32_5_100_2-5_100_2"() {
    %cst = arith.constant dense<""> : tensor<5x100x2xf32>
    %cst_0 = arith.constant dense<""> : tensor<5x100x2xf32>
    %0 = util.optimization_barrier %cst_0 : tensor<5x100x2xf32>
    %1 = util.optimization_barrier %cst_0 : tensor<5x100x2xf32>
    %2 = stablehlo.multiply %0, %1 : tensor<5x100x2xf32>
