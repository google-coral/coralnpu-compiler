"""Bazel module configuration for the CoralNPU Compiler."""

module(
    name = "coralnpu-compiler",
    version = "0.0.1",
)

# --- Bazel Module Dependencies ---

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_python", version = "1.9.2")
bazel_dep(name = "rules_uv", version = "0.89.2")
bazel_dep(name = "rules_pkg", version = "1.3.0")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

# Required by LLVM (for clang-fuzzer tools)
bazel_dep(name = "protobuf", version = "36.2", repo_name = "com_google_protobuf")
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "re2", version = "2025-11-05.bcr.1", repo_name = "com_googlesource_code_re2")

# LLVM also needs these
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_android", version = "0.8.0")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "zlib-ng", version = "2.3.3.bcr.2", repo_name = "llvm_zlib")
bazel_dep(name = "zstd", version = "1.5.7.bcr.2", repo_name = "llvm_zstd")

# Stack trace support on Linux.
bazel_dep(name = "libbacktrace", version = "1.0.0-20250926-7939218.bcr.2")
bazel_dep(name = "llvm-project-overlay", version = "main")
local_path_override(
    module_name = "llvm-project-overlay",
    path = "third_party/llvm-project/utils/bazel",
)

bazel_dep(name = "llvm", version = "0.8.24")
bazel_dep(name = "nanobind", version = "2.12.0.bcr.1")

# For the clangd LSP (generates compile_commands.json)
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)

coralnpuc_extension = use_extension("//build_tools/bazel:extensions.bzl", "coralnpuc_extension")
use_repo(
    coralnpuc_extension,
    "accellera_systemc",
    "libftdi1",
    "libusb",
    "llvm-raw",
    "riscv_isa_sim",
    "rv32_toolchain",
    "verilator",
)

# Use LLVM's extension for third-party dependencies
llvm_repos_ext = use_extension(
    "@llvm-project-overlay//:extensions.bzl",
    "llvm_repos_extension",
)
use_repo(
    llvm_repos_ext,
    # "pyyaml",
    # "vulkan_sdk",
)

inject_repo(llvm_repos_ext, "llvm-raw")

# Configure LLVM using the llvm-raw repo (creates llvm-project)
llvm_configure = use_repo_rule("@llvm-raw//utils/bazel:configure.bzl", "llvm_configure")

llvm_configure(
    name = "llvm-project",
    targets = [
        "AArch64",
        # "AMDGPU",
        # "ARM",
        # "NVPTX",
        "RISCV",
        # "WebAssembly",
        "X86",
    ],
)

bazel_dep(name = "iree_core", version = "0.0.1")
local_path_override(
    module_name = "iree_core",
    path = "third_party/iree",
)

# Use IREE's extension (won't create llvm-raw since you're the root module)
iree_ext = use_extension(
    "@iree_core//build_tools/bazel:extensions.bzl",
    "iree_extension",
)
iree_ext.location(path = "third_party/iree")
iree_ext.register_plugin(
    plugin_id = "coralnpu",
    target = "//compiler/Target:CoralNPUTarget",
)
iree_ext.register_driver(
    driver_name = "coralnpu",
    register_fn = "iree_hal_coralnpu_driver_module_register",
    target = "//runtime/driver/registration",
)

inject_repo(iree_ext, "llvm-raw")

override_repo(
    iree_ext,
    pip = "pip_deps",
)

use_repo(
    iree_ext,
    # "com_github_dvidelabs_flatcc",
    # "com_google_benchmark",
    # "com_google_googletest",
    "stablehlo",
    # "hsa_runtime_headers",
    # "iree_cuda",
    # "llvm-raw",
    # "nccl",
    # "spirv_cross",
    # "tracy_client",
    # "vulkan_headers",
    # "webgpu_headers",
    # "iree_external_plugins",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.13")
python.toolchain(python_version = "3.13")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip_deps",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
    # Uncomment to bypass Airlock, or run `gpkg setup` before bazel
    # extra_pip_args = ["--index-url", "https://pypi.org/simple"],
)
use_repo(pip, "pip_deps")

# --- For LSP integration with clangd ---

# Hedron's Compile Commands Extractor for Bazel
# https://github.com/hedronvision/bazel-compile-commands-extractor
# Recommended by https://clangd.llvm.org/installation and https://bazel.build/install/ide
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    # Write real paths for files that are symlinked into the workspace (for example,
    # external/iree_core+ -> third_party/iree). Without this patch, clangd's background
    # index drops the symbols and references of these files.
    patch_strip = 1,
    patches = [
        "//:hedron-compile-commands-0001-resolve-workspace-symlinks.patch",
    ],
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    # Replace the commit hash (above) with the latest (https://github.com/hedronvision/bazel-compile-commands-extractor/commits/main).
    # Even better, set up Renovate and let it do the work for you (see "Suggestion: Updates" in the README).
)

# --- MPACT & CoralNPU MPACT ---
bazel_dep(name = "mpact-sim", version = "1.0.2")
git_override(
    module_name = "mpact-sim",
    commit = "11dfe5a8e841358b41e012bab1fc2fe18a229728",
    remote = "https://github.com/google/mpact-sim.git",
)

bazel_dep(name = "mpact-riscv", version = "1.0.1")
git_override(
    module_name = "mpact-riscv",
    commit = "19f9b3c0c8670d8425ca237c28d2d6bf1079cfff",
    patch_strip = 1,
    patches = [
        # 0003 and 0004 are written against upstream, so they precede 0001.
        "//:mpact-riscv-0003-zvt-bf16-altfmt.patch",
        "//:mpact-riscv-0004-zvt-bf16-rounding.patch",
        "//:mpact-riscv-0001-speed-up-emulation.patch",
        "//:mpact-riscv-0002-round-vector-fp-to-int-converts.patch",
    ],
    remote = "https://github.com/google/mpact-riscv.git",
)

bazel_dep(name = "coralnpu_mpact", version = "0.0.1")
git_override(
    module_name = "coralnpu_mpact",
    commit = "704b28ce126debd2d951f9c3b36704080d75dc60",
    patch_cmds = [
        "echo 'module(name = \"coralnpu_mpact\", version = \"0.0.1\")' > MODULE.bazel",
        "echo 'bazel_dep(name = \"rules_cc\", version = \"0.2.25\")' >> MODULE.bazel",
        "echo 'bazel_dep(name = \"mpact-sim\", version = \"1.0.2\")' >> MODULE.bazel",
        "echo 'bazel_dep(name = \"mpact-riscv\", version = \"1.0.1\", repo_name = \"com_google_mpact-riscv\")' >> MODULE.bazel",
        "echo 'bazel_dep(name = \"abseil-cpp\", version = \"20260817.0\")' >> MODULE.bazel",
        "echo 'bazel_dep(name = \"protobuf\", version = \"36.2\", repo_name = \"com_google_protobuf\")' >> MODULE.bazel",
        "echo 'bazel_dep(name = \"re2\", version = \"2025-11-05.bcr.1\", repo_name = \"com_googlesource_code_re2\")' >> MODULE.bazel",
        # decoder_gen resolves .isa/.bin_fmt includes from the execroot; C++ ones use riscv/.
        "sed -i 's|^#include .external/com_google_mpact-riscv/|#include \"external/mpact-riscv+/|' sim/*.isa sim/*.bin_fmt",
        "sed -i 's|external/com_google_mpact-riscv/riscv/|riscv/|g' sim/*.isa sim/*.bin_fmt",
        "sed -i '1i package(default_visibility = [\"//visibility:public\"])' sim/hw_sim/BUILD",
    ],
    patch_strip = 1,
    patches = [
        "//:coralnpu-mpact-0001-vme-m4-decoder.patch",
    ],
    remote = "https://github.com/google-coral/coralnpu-mpact.git",
)

# --- CoralNPU Hardware Submodule ---
bazel_dep(name = "coralnpu_hw", version = "0.0.1")
local_path_override(
    module_name = "coralnpu_hw",
    path = "third_party/coralnpu",
)

coralnpu_deps_ext = use_extension("@coralnpu_hw//rules:extensions.bzl", "coralnpu_deps_ext")
use_repo(
    coralnpu_deps_ext,
    "com_github_westes_flex",
    "coralnpu_host_cpus",
    "net_zlib",
    "org_gnu_bison",
    "org_gnu_m4",
)

override_repo(
    coralnpu_deps_ext,
    accellera_systemc = "accellera_systemc",
    riscv_isa_sim = "riscv_isa_sim",
    verilator = "verilator",
)

# Configure rules_scala globally
bazel_dep(name = "rules_scala", version = "7.3.0", repo_name = "io_bazel_rules_scala")

scala_config = use_extension("@io_bazel_rules_scala//scala/extensions:config.bzl", "scala_config")
scala_config.settings(
    scala_version = "2.13.18",
)

scala_deps = use_extension("@io_bazel_rules_scala//scala/extensions:deps.bzl", "scala_deps")
scala_deps.scala()

