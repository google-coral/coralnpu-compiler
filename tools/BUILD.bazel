load("//build_tools/bazel:static_binary.bzl", "static_fpga_binary")

package(default_visibility = ["//visibility:public"])

# Standalone static IREE runner binaries with the FPGA and MPACT backends
# linked in (no shared-library or host glibc dependencies).
static_fpga_binary(
    name = "iree-run-module-static",
    target = "@iree_core//tools:iree-run-module",
)

static_fpga_binary(
    name = "iree-check-module-static",
    testonly = True,
    target = "@iree_core//tools:iree-check-module",
)
