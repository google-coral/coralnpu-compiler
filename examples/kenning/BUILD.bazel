load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")

package(default_visibility = ["//visibility:public"])

py_console_script_binary(
    name = "kenning",
    pkg = "@pip_deps//kenning",
    deps = [
        "@iree_core//runtime/bindings/python:runtime",
    ],
)

genrule(
    name = "test_magic_wand_jax",
    srcs = [
        "scenarios/magic-wand-jax.yml",
        "//:riscv32_linker_copy",
        "//compiler/tools:coralnpu-compile",
        "//crt:crt_files",
        "@coralnpu_mpact//sim/hw_sim:libcoralnpu_simulator_mpact.so",
    ],
    outs = [
        "reports/magic-wand-jax.tar",
        "data/magic-wand-jax.json",
    ],
    cmd = """
      set -euo pipefail

      export KENNING_CACHE_DIR=./kenning_cache
      export IREE_LINKER_PATH=$(location //:riscv32_linker_copy)
      export IREE_COMPILER_PATH=$(location //compiler/tools:coralnpu-compile)
      export LD_LIBRARY_PATH=$$(realpath $$(dirname $(location @coralnpu_mpact//sim/hw_sim:libcoralnpu_simulator_mpact.so)))

      $(location :kenning) \
        optimize test report \
        --cfg $(location scenarios/magic-wand-jax.yml)

      tar -cf "$(location reports/magic-wand-jax.tar)" -C reports/magic-wand-jax .
      cp data/magic-wand-jax.json $(location data/magic-wand-jax.json)
    """,
    tools = [
        ":kenning",
    ],
)

