load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "reference.npy",
    "reference_160.npy",
])

py_binary(
    name = "export_yolo",
    srcs = ["export_yolo.py"],
    deps = [
        "//examples:utils",
        "@pip_deps//keras",
        "@pip_deps//tosa_converter_for_tflite",
    ],
)

py_binary(
    name = "detect_yolo",
    srcs = ["detect_yolo.py"],
    data = [
        "//examples/mobilenetv2-jax-aot:cat.jpg",
    ],
    deps = [
        "//examples:utils",
        "@pip_deps//numpy",
        "@pip_deps//pillow",
    ],
)

py_binary(
    name = "export_yolo_160",
    srcs = ["export_yolo_160.py"],
    data = [
        "yolov8n_160.tflite",
    ],
    deps = [
        "//examples:utils",
        "@pip_deps//tosa_converter_for_tflite",
    ],
)

py_binary(
    name = "detect_yolo_160",
    srcs = [
        "detect_yolo.py",
        "detect_yolo_160.py",
    ],
    data = [
        "//examples/mobilenetv2-jax-aot:cat.jpg",
    ],
    imports = ["."],
    deps = [
        "//examples:utils",
        "@pip_deps//numpy",
        "@pip_deps//pillow",
    ],
)
