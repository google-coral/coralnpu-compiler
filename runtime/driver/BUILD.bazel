load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

cc_library(
    name = "coralnpu",
    srcs = [
        "coralnpu_command_buffer.c",
        "coralnpu_device.c",
        "coralnpu_driver.c",
        "coralnpu_executable.c",
        "coralnpu_executable_cache.c",
    ],
    hdrs = [
        "coralnpu_command_buffer.h",
        "coralnpu_device.h",
        "coralnpu_driver.h",
        "coralnpu_exec_backend.h",
        "coralnpu_executable.h",
        "coralnpu_executable_cache.h",
    ],
    deps = [
        ":dispatch_observer",
        ":run_hooks",
        "@iree_core//runtime/src/iree/async",
        "@iree_core//runtime/src/iree/async/util:proactor_pool",
        "@iree_core//runtime/src/iree/base",
        "@iree_core//runtime/src/iree/base/internal:arena",
        "@iree_core//runtime/src/iree/hal",
        "@iree_core//runtime/src/iree/hal/drivers/local_sync:sync_driver",
        "@iree_core//runtime/src/iree/hal/local:executable_library",
        "@iree_core//runtime/src/iree/hal/local/elf:elf_module",
        "@iree_core//runtime/src/iree/hal/utils:deferred_command_buffer",
        "@iree_core//runtime/src/iree/hal/utils:file_transfer",
        "@iree_core//runtime/src/iree/hal/utils:files",
        "@iree_core//runtime/src/iree/hal/utils:queue_emulation",
    ],
)

# The hooks an execution backend calls while it runs a dispatch, through which
# code outside the driver (e.g. //metrics/runtime) observes the run.
cc_library(
    name = "run_hooks",
    hdrs = ["coralnpu_run_hooks.h"],
)

# The interface between a device and the observer of its dispatches (e.g. the
# statistics writer in //metrics/runtime).
cc_library(
    name = "dispatch_observer",
    hdrs = ["coralnpu_dispatch_observer.h"],
    deps = [
        ":run_hooks",
        "@iree_core//runtime/src/iree/base",
    ],
)
