load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

cc_library(
    name = "simulator",
    srcs = ["simulator.cpp"],
    linkstatic = True,
    deps = [
        "@coralnpu_hw//hw_sim:coralnpu_simulator_headers",
        "@coralnpu_hw//sw/utils/nexus_loader:spi_master",
        "@libftdi1",
    ],
    alwayslink = True,
)

cc_binary(
    name = "libcoralnpu_simulator_fpga.so",
    linkshared = True,
    deps = [":simulator"],
)
