load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:defs.bzl", "cc_import")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(["libcoralnpu_simulator_mpact.so"])

# Equivalent to the CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64" check
config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Define the build flag
string_flag(
    name = "simulator_type",
    build_setting_default = "mpact",
    values = [
        "mpact",
        "verilator",
    ],
)

config_setting(
    name = "use_mpact",
    flag_values = {":simulator_type": "mpact"},
)

config_setting(
    name = "use_verilator",
    flag_values = {":simulator_type": "verilator"},
)

# Target: simulator (formerly mpact_simulator)
cc_library(
    name = "simulator",
    srcs = select({
        ":linux_x86_64": ["simulator.cpp"],
        "//conditions:default": [],
    }),
    hdrs = select({
        ":linux_x86_64": ["simulator_api.h"],
        "//conditions:default": [],
    }),
    local_defines = select({
        ":use_mpact": ["USE_MPACT_PREBUILT"],
        ":use_verilator": ["USE_VERILATOR"],
    }),
    visibility = ["//visibility:public"],
    deps = select({
        ":use_mpact": [":simulator_lib_import"],
        ":use_verilator": [
            "@coralnpu_hw//hw_sim:coralnpu_simulator_headers",
            "@coralnpu_hw//hw_sim:core_mini_axi_simulator_rvv",
        ],
    }),
)

# Target: simulation
cc_library(
    name = "simulation",
    srcs = select({
        ":linux_x86_64": [
            "simulator_elf_loader.c",
            "simulator_executable.c",
            "simulator_inline.c",
        ],
        "//conditions:default": [],
    }),
    hdrs = select({
        ":linux_x86_64": [
            "simulator_api.h",
            "simulator_elf_loader.h",
            "simulator_executable.h",
            "simulator_format.h",
            "simulator_inline.h",
            "//runtime/driver:coralnpu_executable.h",
        ],
        "//conditions:default": [],
    }),
    deps = select({
        ":linux_x86_64": [
            ":simulator",
            "//crt:coralnpu_dispatch_hdrs",
            "@iree_core//runtime/src/iree/base",
            "@iree_core//runtime/src/iree/base/internal",
            "@iree_core//runtime/src/iree/hal",
            "@iree_core//runtime/src/iree/hal/local:executable_environment",
            "@iree_core//runtime/src/iree/hal/local:executable_library",
            "@iree_core//runtime/src/iree/hal/local:executable_loader",
        ],
        "//conditions:default": [],
    }),
)

# Wrapper for the precompiled .so file
cc_import(
    name = "simulator_lib_import",
    shared_library = "libcoralnpu_simulator_mpact.so",
)
