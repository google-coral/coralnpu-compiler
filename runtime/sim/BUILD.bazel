load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# Equivalent to the CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64" check
config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Target: simulator_mpact
cc_library(
    name = "simulator_mpact",
    deps = [
        "@coralnpu_mpact//sim/hw_sim:coralnpu_simulator_headers",
        "@coralnpu_mpact//sim/hw_sim:mpact_simulator",
    ],
)

# Target: simulator_verilator
cc_library(
    name = "simulator_verilator",
    deps = [
        "@coralnpu_hw//hw_sim:coralnpu_simulator_headers",
        "@coralnpu_hw//hw_sim:core_mini_axi_simulator_vme",
    ],
)

# Target: simulator_fpga
cc_library(
    name = "simulator_fpga",
    deps = [
        "//runtime/sim/fpga:simulator",
    ],
)

# Target: simulator (common dispatch implementation)
cc_library(
    name = "simulator",
    srcs = select({
        ":linux_x86_64": ["simulator.cpp"],
        "//conditions:default": [],
    }),
    hdrs = select({
        ":linux_x86_64": ["simulator_api.h"],
        "//conditions:default": [],
    }),
    deps = [
        "@coralnpu_hw//hw_sim:coralnpu_simulator_headers",
    ],
)

# Target: simulation
cc_library(
    name = "simulation",
    srcs = select({
        ":linux_x86_64": [
            "simulator_backend.c",
            "simulator_elf_loader.c",
            "simulator_inline.c",
        ],
        "//conditions:default": [],
    }),
    hdrs = select({
        ":linux_x86_64": [
            "simulator_api.h",
            "simulator_backend.h",
            "simulator_elf_loader.h",
            "simulator_inline.h",
        ],
        "//conditions:default": [],
    }),
    deps = select({
        ":linux_x86_64": [
            ":simulator",
            "//crt:coralnpu_dispatch_hdrs",
            "//runtime/driver:coralnpu",
            "@iree_core//runtime/src/iree/base",
            "@iree_core//runtime/src/iree/hal/local:executable_library",
        ],
        "//conditions:default": [],
    }),
)
