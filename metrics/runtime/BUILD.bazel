# Per-dispatch execution statistics of the CoralNPU HAL driver: the record,
# the collector that fills it through the run hooks of the execution backends
# (//runtime/driver:run_hooks), and the writer that the driver calls as its
# dispatch observer (//runtime/driver:dispatch_observer). Depends only on these
# hook interfaces of the driver, not on the driver or the simulators.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# The statistics of a single dispatch.
cc_library(
    name = "dispatch_stats",
    hdrs = ["dispatch_stats.h"],
)

# Collects the statistics of a dispatch through the run hooks.
cc_library(
    name = "stats_collector",
    srcs = ["stats_collector.c"],
    hdrs = ["stats_collector.h"],
    deps = [
        ":dispatch_stats",
        "//crt:coralnpu_dispatch_hdrs",
        "//runtime/driver:run_hooks",
    ],
)

# Writes the statistics as JSON Lines or as a summary table
# (--coralnpu_stats_format).
cc_library(
    name = "stats_writer",
    srcs = ["stats_writer.c"],
    hdrs = ["stats_writer.h"],
    deps = [
        ":dispatch_stats",
        ":stats_collector",
        "//runtime/driver:dispatch_observer",
        "@iree_core//runtime/src/iree/base",
        "@iree_core//runtime/src/iree/base/threading",
    ],
)

# The --coralnpu_stats_* flags, which configure the statistics writer.
cc_library(
    name = "stats_flags",
    srcs = ["stats_flags.c"],
    hdrs = ["stats_flags.h"],
    deps = [
        ":stats_writer",
        "//runtime/driver:dispatch_observer",
        "@iree_core//runtime/src/iree/base",
        "@iree_core//runtime/src/iree/base/tooling:flags",
    ],
)
