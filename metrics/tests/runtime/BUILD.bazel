load("@rules_python//python:defs.bzl", "py_test")
load("//build_tools/bazel:bytecode_module.bzl", "coralnpu_bytecode_module")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

coralnpu_bytecode_module(
    name = "stats_test_module",
    src = "stats_test.mlir",
    flags = ["--iree-hal-target-device=coralnpu"],
)

py_test(
    name = "stats_test",
    timeout = "moderate",
    srcs = ["stats_test.py"],
    args = [
        "--check-module=$(rootpath @iree_core//tools:iree-check-module)",
        "--module=$(rootpath :stats_test_module.vmfb)",
    ],
    data = [
        ":stats_test_module.vmfb",
        "@iree_core//tools:iree-check-module",
    ],
    main = "stats_test.py",
    tags = [
        "ci",
        "driver=coralnpu",
        "simulator=mpact",
        "target=coralnpu",
    ],
)

test_suite(
    name = "ci",
    tags = ["ci"],
)
