# Workload reports (metrics/tools/defs.bzl): each test prints the report of a
# workload and writes report.md and report.json to its test outputs
# (bazel-testlogs/metrics/tests/report/<target>/test.outputs/).

load("//metrics/tools:defs.bzl", "coralnpu_workload_report")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

# A small model with two dispatches: Zvt matmuls with RVV epilogues.
coralnpu_workload_report(
    name = "mlp_f32",
    src = "mlp_f32.mlir",
    inputs = [
        "16x64xf32=1",
        "64x32xf32=0.5",
        "32xf32=0.25",
        "32x16xf32=-0.1",
    ],
    tags = ["ci"],
)

test_suite(
    name = "ci",
    tags = ["ci"],
)
