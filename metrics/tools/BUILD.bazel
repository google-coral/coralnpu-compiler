# The workload report: merges the compiler metrics bundles and the runtime
# stats of a workload (see metrics/README.md).

load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

py_library(
    name = "report_lib",
    srcs = ["report.py"],
)

# Writes the report of compiler metrics bundles and runtime stats files.
py_binary(
    name = "report",
    srcs = ["report.py"],
)

py_library(
    name = "workload_report_lib",
    srcs = ["workload_report.py"],
    deps = [":report_lib"],
)

# Runs a module with the runtime stats and writes its report; the test of
# coralnpu_workload_report (defs.bzl).
py_binary(
    name = "workload_report",
    srcs = ["workload_report.py"],
    deps = [":report_lib"],
)
