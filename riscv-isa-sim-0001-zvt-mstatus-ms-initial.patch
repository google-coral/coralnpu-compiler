From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lun Dong <lundong@google.com>
Date: Wed, 28 Oct 2026 00:00:00 -0700
Subject: [PATCH] Initialize mstatus.MS to Initial with Zvt

mstatus.MS reset to Off, so every Zvt tile instruction trapped unless
software enabled MS first. The CoralNPU hardware resets MS to Initial
(Csr.scala), as Spike already does for FS and VS.
---
diff --git a/riscv/csrs.cc b/riscv/csrs.cc
--- a/riscv/csrs.cc
+++ b/riscv/csrs.cc
@@ -740,6 +740,7 @@ reg_t mstatus_csr_t::compute_mstatus_initial_value() const noexcept {
          | (proc->extension_enabled(EXT_SMDBLTRP) ? MSTATUS_MDT : 0)
          | (proc->extension_enabled('F') ? set_field((reg_t)0, MSTATUS_FS, 1) : 0)
          | (proc->any_vector_extensions() ? set_field((reg_t)0, MSTATUS_VS, 1) : 0)
+         | (proc->extension_enabled(EXT_ZVTBASE) ? set_field((reg_t)0, MSTATUS_MS, 1) : 0)
          | 0;  // initial value for mstatus
 }
 
